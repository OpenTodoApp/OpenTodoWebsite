---
// The familiar GitHub Sponsors button (website-support-page D2), drawn by the site:
// light grey with GitHub's pink heart, the same in both themes like the coffee and
// Discord buttons. Nothing is loaded from github.com. The heart is the button's own
// mark, not a UI icon.
import { SITE } from '../lib/site';
interface Props { small?: boolean }
const { small = false } = Astro.props;
---
<a class:list={['btn', 'btn-sponsor', { 'btn-small': small }]} href={SITE.sponsor} data-sponsor>
  <svg width={small ? 16 : 18} height={small ? 16 : 18} viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <path fill="currentColor" d="M7.655 14.916v-.001h-.002l-.006-.003-.018-.01a22.066 22.066 0 0 1-3.744-2.584C2.045 10.731 0 8.35 0 5.5 0 2.836 2.086 1 4.25 1 5.797 1 7.153 1.802 8 3.02 8.847 1.802 10.203 1 11.75 1 13.914 1 16 2.836 16 5.5c0 2.85-2.044 5.231-3.886 6.818a22.094 22.094 0 0 1-3.433 2.414 7.152 7.152 0 0 1-.31.17l-.018.01-.008.004a.75.75 0 0 1-.69 0Z" />
  </svg>
  Sponsor on GitHub
</a>
