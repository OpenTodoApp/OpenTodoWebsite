---
// "Buy me a coffee", in the site's own secondary button style with the bundle's
// coffee icon (website-section-system D6): no colour outside the tokens, and no
// script, font or image from buymeacoffee.com (website-platform: no third-party
// requests). Shown in the footer and on /about/ only.
import Icon from './Icon.astro';
import { SITE } from '../lib/site';
interface Props { small?: boolean }
const { small = false } = Astro.props;
---
<a class:list={['btn', 'btn-secondary', { 'btn-small': small }]} href={SITE.coffee} data-coffee><Icon name="coffee" size={small ? 16 : 18} /> Buy me a coffee</a>
