---
// Shared page for guides and toolkit pieces: last-reviewed date, the
// templates the piece uses, its docs sources, and the closing calls to action.
import { getEntries, render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleLayout from './ArticleLayout.astro';
import EndCta from './EndCta.astro';
import Icon from './Icon.astro';
import JsonLd from './JsonLd.astro';
import { SITE } from '../lib/site';
import authors from '../content/authors.json';
import { LEARN_TYPES, learnEntries } from '../lib/learn';

type Entry = CollectionEntry<'guides'> | CollectionEntry<'toolkit'>;
interface Props { entry: Entry; section: { href: string; label: string } }
const { entry, section } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);
// Where the piece sits in its Learn list, and what follows it (website-article-layout D2).
const type = entry.collection === 'guides' ? 'methods' : 'setup';
const href = `/${entry.collection}/${entry.id}/`;
const list = (await learnEntries()).filter((e) => e.type === type);
const at = list.findIndex((e) => e.href === href);
const me = list[at];
const position = { label: LEARN_TYPES.find((t) => t.key === type)!.label, index: at + 1, total: list.length, prev: list[at - 1], next: list[at + 1] };
const templates = await getEntries(d.templates.map((id) => ({ collection: 'templates' as const, id })));
templates.forEach((t, i) => { if (!t) throw new Error(`${entry.collection}/${entry.id} lists template "${d.templates[i]}", which does not exist`); });
const reviewed = d.lastReviewed.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Base title={d.title} description={d.summary} ogType="article">
  <JsonLd slot="head" data={[
    { '@type': 'Article', headline: d.title, description: d.summary, dateModified: d.lastReviewed.toISOString().slice(0, 10), inLanguage: 'en', author: { '@type': 'Person', name: authors.raffaele.name, url: authors.raffaele.url }, publisher: { '@type': 'Organization', name: 'OpenTodo', url: SITE.url }, mainEntityOfPage: `${SITE.url}${href}` },
    { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Learn', item: `${SITE.url}/learn/` }, { '@type': 'ListItem', position: 2, name: section.label, item: `${SITE.url}${section.href}` }, { '@type': 'ListItem', position: 3, name: d.title, item: `${SITE.url}${href}` }] },
  ]} />
  <ArticleLayout
    title={d.title}
    summary={d.summary}
    crumbs={[{ href: '/learn/', label: 'Learn' }, section]}
    position={position}
    headings={headings}
    facts={[
      { label: 'Reading time', value: me?.length ?? '' },
      ...(me?.topic ? [{ label: 'Topic', value: me.topic }] : []),
      { label: 'Reviewed', value: reviewed },
    ]}
    sources={d.sources}
    next={[position.next, ...list.filter((e) => e !== position.next && e.href !== href && e.topic === me?.topic)].filter(Boolean).slice(0, 2) as { href: string; title: string }[]}
  >
    <Content />
  </ArticleLayout>
  {templates.length > 0 && (
    <section class="section section-alt" aria-labelledby="related-templates">
      <div class="wrap">
        <h2 id="related-templates" style="font-size: 1.5rem">Templates for this</h2>
        <div class="grid grid-3">
          {templates.map((t) => t && (
            <a class="card" href={`/templates/${t.id}/`}>
              <span class="card-icon"><Icon name="layout-template" size={22} /></span>
              <h3>{t.data.title}</h3>
              <p>{t.data.summary}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
  <EndCta />
</Base>
