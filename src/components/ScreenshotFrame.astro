---
// A real screenshot from the bundle in a frame drawn from the tokens (browser or
// phone), as a responsive <picture>: AVIF and WebP at several widths, and the
// dark capture for visitors who prefer dark when the bundle has one.
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { manifest } from '../lib/bundle';

interface Props {
  shot: string;
  alt: string;
  frame?: 'browser' | 'phone' | 'none';
  caption?: string;
  url?: string;
  sizes?: string;
  eager?: boolean;
  class?: string;
  /** data-* hooks for islands (the feature tour swaps the image). */
  imgAttrs?: Record<string, string>;
}
const { shot, alt, frame = 'browser', caption, url = 'todo.your-server.com', eager = false, class: className, imgAttrs = {} } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('@bundle/shots/*.{webp,png,jpg}', { eager: true });
const byName = (name: string) => {
  const entry = manifest.shots[name];
  if (!entry) throw new Error(`Screenshot "${name}" is not in the bundle manifest`);
  const key = Object.keys(files).find((k) => k.endsWith(`/shots/${entry.file}`));
  if (!key) throw new Error(`Screenshot file ${entry.file} is missing from the bundle's shots/`);
  return files[key].default;
};

const light = byName(shot);
const darkName = manifest.darkVariants?.[shot];
const dark = darkName ? byName(darkName) : undefined;
const widths = (frame === 'phone' ? [280, 420, 560] : [480, 800, 1200, 1600, 2160]).filter((w) => w <= light.width);
const sizes = Astro.props.sizes ?? (frame === 'phone' ? '(min-width: 640px) 280px, 45vw' : '(min-width: 1200px) 760px, (min-width: 1024px) 60vw, 100vw');

const sources = async (img: ImageMetadata, media?: string) =>
  Promise.all(
    (['avif', 'webp'] as const).map(async (format) => {
      const r = await getImage({ src: img, widths, format, quality: format === 'avif' ? 55 : 72 });
      return { type: `image/${format}`, srcset: r.srcSet.attribute, media };
    }),
  );
const list = [...(dark ? await sources(dark, '(prefers-color-scheme: dark)') : []), ...(await sources(light))];
const fallback = await getImage({ src: light, width: Math.min(1200, light.width), format: 'webp' });
---
<figure class:list={[frame === 'none' ? '' : 'frame', frame === 'phone' && 'frame-phone', className]}>
  {frame === 'browser' && <div class="frame-bar" aria-hidden="true"><i /><i /><i /><span>{url}</span></div>}
  <picture>
    {list.map((s) => <source type={s.type} srcset={s.srcset} sizes={sizes} media={s.media} />)}
    <img src={fallback.src} width={light.width} height={light.height} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" {...imgAttrs} />
  </picture>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
