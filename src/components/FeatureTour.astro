---
// Screenshot tour (island). Without JavaScript every chapter and feature is
// listed with its docs link and the first screenshot shows; with it, chapters
// become tabs and each feature shows its own screenshot.
import Icon from './Icon.astro';
import ScreenshotFrame from './ScreenshotFrame.astro';
import { TOUR } from '../lib/tour';

const features = TOUR.flatMap((c) => c.features.map((f, i) => ({ ...f, chapter: c.id, key: `${c.id}-${i}` })));
---
<div class="tour" data-tour>
  <div>
    <div class="tour-chapters" data-tour-chapters aria-label="Tour chapters">
      {TOUR.map((c, i) => <button type="button" id={`chapter-${c.id}`} data-chapter={c.id} aria-selected={i === 0 ? 'true' : 'false'}>{c.label}</button>)}
    </div>
    {TOUR.map((c) => (
      <div class="tour-panel" id={`tour-panel-${c.id}`} data-panel-for={c.id}>
        <h3>{c.label}</h3>
        <ul>
          {c.features.map((f, i) => (
            <li>
              <button type="button" class="tour-feature" data-shot={`${c.id}-${i}`} aria-controls={`shot-${c.id}-${i}`}>
                <b>{f.title}</b>
                <span set:html={f.text} />
              </button>
              <a class="visually-hidden" href={f.doc}>{f.title} in the docs</a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <div class="tour-figure" aria-live="polite">
    {features.map((f, i) => (
      <div id={`shot-${f.key}`} data-tour-shot={f.key} hidden={i !== 0}>
        <ScreenshotFrame shot={f.shot} alt={f.alt} imgAttrs={{ 'data-tour-img': '' }} />
        <p class="meta" style="margin-top: 0.75rem"><a class="link-arrow" href={f.doc}>{f.title}: how it works <Icon name="arrow-right" size={16} /></a></p>
      </div>
    ))}
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-tour]');
  if (root) {
    const chapters = [...root.querySelectorAll<HTMLButtonElement>('[data-chapter]')];
    const panelOf = (ch: HTMLElement) => root.querySelector<HTMLElement>(`[data-panel-for="${ch.dataset.chapter}"]`)!;
    const featuresOf = (panel: HTMLElement) => [...panel.querySelectorAll<HTMLButtonElement>('[data-shot]')];
    const shots = [...root.querySelectorAll<HTMLElement>('[data-tour-shot]')];
    const chosen = new Map<string, HTMLButtonElement>();

    // Tabs for chapters; the features of a chapter are toggle buttons.
    root.querySelector('[data-tour-chapters]')!.setAttribute('role', 'tablist');
    chapters.forEach((ch) => {
      ch.setAttribute('role', 'tab');
      ch.setAttribute('aria-controls', `tour-panel-${ch.dataset.chapter}`);
      const panel = panelOf(ch);
      panel.setAttribute('role', 'tabpanel');
      panel.setAttribute('aria-labelledby', ch.id);
    });

    const showFeature = (btn: HTMLButtonElement, focus = false) => {
      const panel = btn.closest<HTMLElement>('[data-panel-for]')!;
      featuresOf(panel).forEach((f) => f.setAttribute('aria-pressed', String(f === btn)));
      chosen.set(panel.dataset.panelFor!, btn);
      shots.forEach((s) => { s.hidden = s.dataset.tourShot !== btn.dataset.shot; });
      if (focus) btn.focus();
    };
    const showChapter = (ch: HTMLButtonElement, focus = false) => {
      chapters.forEach((c) => { const on = c === ch; c.setAttribute('aria-selected', String(on)); c.tabIndex = on ? 0 : -1; panelOf(c).hidden = !on; });
      showFeature(chosen.get(ch.dataset.chapter!) ?? featuresOf(panelOf(ch))[0]);
      if (focus) ch.focus();
    };
    chapters.forEach((ch, i) => {
      ch.addEventListener('click', () => showChapter(ch));
      ch.addEventListener('keydown', (e) => {
        const j = e.key === 'ArrowRight' ? (i + 1) % chapters.length : e.key === 'ArrowLeft' ? (i - 1 + chapters.length) % chapters.length : e.key === 'Home' ? 0 : e.key === 'End' ? chapters.length - 1 : -1;
        if (j < 0) return;
        e.preventDefault(); showChapter(chapters[j], true);
      });
      featuresOf(panelOf(ch)).forEach((f) => f.addEventListener('click', () => showFeature(f)));
    });
    showChapter(chapters[0]);
  }
</script>
