---
// Where the Android app comes from today (GitHub, as the pinned docs say), and a warning about
// apps with similar names. Update once the store listings are public.
import Icon from './Icon.astro';
import { p as strings } from '../i18n/path/index.mjs';

interface Props { lang?: 'en' | 'de' }
const { lang = 'en' } = Astro.props;
const s = strings(lang).notices;
---
<aside class="post-notice post-notice-dev" aria-label={s.androidLabel}>
  <Icon name="flag" size={20} />
  <p set:html={s.android} />
</aside>
