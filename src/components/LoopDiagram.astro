---
// The Open Loops cycle (website-open-loops D3, D4): the five moves of the pinned
// release's method.json on a circle, each leading to the next and Review back to
// Catch. Text is HTML (it wraps, translates and scales); only the arrows are SVG,
// drawn in the current colour. Each move links to its entry in the list below, so the
// diagram works without JavaScript; the island script turns the links into a chooser
// that shows the move's description, shortcut and screen in the centre.
import { method, screenOf, tagline, term } from '../lib/bundle';

interface Labels { shortcut: string; screen: string; docs: string; choose: string }
interface Props { lang?: string; labels?: Labels }
const { lang = 'en', labels = { shortcut: 'Shortcut', screen: 'Where', docs: 'In the docs', choose: 'Choose a move to see what it does.' } } = Astro.props;
const moves = (method?.moves ?? []).map((m, i) => ({ ...m, i, ...term(m, lang), screen: screenOf(m) ? term(screenOf(m)!, lang).name : undefined }));
const docsLink = (id: string) => `/docs/method/${id}/`;
const keys = (k?: string) => (k ? k.split(' ') : []);

// Arrows between neighbouring moves on a circle of radius 40 in a 100 × 100 box,
// leaving a gap around each label.
const R = 40, GAP = 17;
const point = (deg: number) => [50 + R * Math.cos((deg * Math.PI) / 180), 50 + R * Math.sin((deg * Math.PI) / 180)].map((n) => n.toFixed(2));
const angle = (i: number) => -90 + (i * 360) / Math.max(moves.length, 1);
const arcs = moves.map((_, i) => {
  const [x1, y1] = point(angle(i) + GAP);
  const [x2, y2] = point(angle(i + 1) - GAP);
  return `M${x1} ${y1} A${R} ${R} 0 0 1 ${x2} ${y2}`;
});
---
{method && (
  <div class="loop" data-loop>
    <div class="loop-stage">
      <svg class="loop-arrows" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
        <defs>
          <marker id="loop-head" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M0 0 10 5 0 10z" fill="currentColor" /></marker>
        </defs>
        {arcs.map((d) => <path d={d} fill="none" stroke="currentColor" stroke-width="0.6" stroke-linecap="round" marker-end="url(#loop-head)" />)}
      </svg>
      <ol class="loop-moves">
        {moves.map((m) => (
          <li style={`--a: ${angle(m.i)}deg`}>
            <a class="loop-move" href={`#move-${m.id}`} data-move={m.id} aria-current={m.i === 0 ? 'true' : undefined}>
              <span class="loop-num" aria-hidden="true">{m.i + 1}</span>
              <span class="loop-name">{m.name}</span>
            </a>
          </li>
        ))}
      </ol>
      <div class="loop-centre" aria-live="polite">
        <p class="loop-tagline">{tagline(lang)}</p>
        {moves.map((m) => (
          <div class="loop-detail" data-detail={m.id} hidden>
            <p class="loop-detail-name">{m.name}</p>
            <p>{m.description}</p>
            {m.keys && <p class="meta">{labels.shortcut}: {keys(m.keys).map((k, j) => <>{j > 0 && ' '}<kbd>{k}</kbd></>)}</p>}
            {m.screen && <p class="meta">{labels.screen}: {m.screen}</p>}
            <p class="meta"><a href={docsLink(m.id)}>{labels.docs}</a></p>
          </div>
        ))}
      </div>
    </div>
    <ol class="loop-list">
      {moves.map((m) => (
        <li id={`move-${m.id}`}>
          <h3>{m.name}</h3>
          <p>{m.description}</p>
          {(m.keys || m.screen) && (
            <p class="meta">
              {m.keys && <>{labels.shortcut}: {keys(m.keys).map((k, j) => <>{j > 0 && ' '}<kbd>{k}</kbd></>)}</>}
              {m.keys && m.screen && ' · '}
              {m.screen && <>{labels.screen}: {m.screen}</>}
            </p>
          )}
          <p class="meta"><a href={docsLink(m.id)}>{labels.docs}: {m.name}</a></p>
        </li>
      ))}
    </ol>
  </div>
)}

<script>
  // Choosing a move shows it in the centre; the links stay links without this script.
  for (const root of document.querySelectorAll<HTMLElement>('[data-loop]')) {
    const links = [...root.querySelectorAll<HTMLAnchorElement>('[data-move]')];
    const details = [...root.querySelectorAll<HTMLElement>('[data-detail]')];
    const tag = root.querySelector<HTMLElement>('.loop-tagline');
    const choose = (id: string) => {
      for (const a of links) {
        if (a.dataset.move === id) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      }
      for (const d of details) d.hidden = d.dataset.detail !== id;
      if (tag) tag.hidden = true;
    };
    for (const a of links) a.addEventListener('click', (e) => { e.preventDefault(); choose(a.dataset.move!); });
    root.classList.add('is-interactive');
    if (links[0]) choose(links[0].dataset.move!);
  }
</script>
