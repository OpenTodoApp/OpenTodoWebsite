---
// The landing page in every language (website-landing): a claim, two actions and the real app
// moving through Today, quick add and a board; then why it is different, everything included,
// yours for good, the four ways in, the community and the latest posts. Plain HTML and CSS: the
// product stage is a CSS crossfade of the pinned release's screenshots that stays on Today when
// the visitor prefers reduced motion. Strings come from src/i18n/<lang>.mjs; feature names,
// integrations, app names and posts stay English (lang="en").
import DiscordButton from '../DiscordButton.astro';
import Icon from '../Icon.astro';
import ScreenshotFrame from '../ScreenshotFrame.astro';
import LangNote from '../LangNote.astro';
import PostRow from '../blog/PostRow.astro';
import { NAV, SITE } from '../../lib/site';
import { publishedPosts } from '../../lib/blog';
import { featureCount, featureGroups, importApps, integrations } from '../../lib/features';
import { DEFAULT_LANG } from '../../i18n/index.mjs';
import { fill } from '../../i18n/dict.mjs';
import type en from '../../i18n/en.mjs';

interface Props { lang: string; s: typeof en.home }
const { lang, s } = Astro.props;
const translated = lang !== DEFAULT_LANG;
const enLang = translated ? 'en' : undefined;

const latestPosts = (await publishedPosts()).slice(0, 3);
const groups = featureGroups();
const count = featureCount();
const groupTitle = (key: string, fallback: string) => (s.features.groups as Record<string, string>)[key] ?? fallback;

// The stage: three real screens of the pinned release, each with its caption.
const slides = [
  { shot: 'today', caption: `${s.hero.say} ${s.hero.late} ${s.hero.soft}`, alt: s.hero.alt },
  { shot: 'quick-add', caption: s.day.quickCaption, alt: s.day.quickAlt },
  { shot: 'board', caption: s.day.boardCaption, alt: s.day.boardAlt },
];
const dayRows = [
  { icon: 'sun', doc: '/docs/briefing/' },
  { icon: 'zap', doc: '/docs/quick-add/' },
  { icon: 'kanban', doc: '/docs/sections-and-boards/' },
].map((d, i) => ({ ...d, ...s.day.rows[i] }));
const yours = [
  { icon: 'wallet', href: '/self-host/plan/' },
  { icon: 'server', href: '/docs/self-hosting/docker/' },
  { icon: 'wifi-off', href: '/docs/offline-and-sync/' },
  { icon: 'lock', href: '/docs/e2ee/' },
  { icon: 'bot', href: '/toolkit/ai-on-your-terms/' },
].map((y, i) => ({ ...y, ...s.yours.rows[i] }));
const ways = [
  { icon: 'monitor', href: SITE.demo, moreHref: '/docs/self-hosting/demo/', primary: true },
  { icon: 'globe', href: SITE.pikapods, moreHref: '/start/#run' },
  { icon: 'smartphone', href: '/install/', moreHref: '/docs/install-app/' },
  { icon: 'server', href: '/self-host/', moreHref: '/self-host/plan/' },
].map((w, i) => ({ ...w, ...s.ways.items[i] }));
---
<section class="lp-hero" aria-labelledby="hero-title">
  <div class="wrap lp-hero-text">
    <h1 id="hero-title">{s.hero.ledeStrong}</h1>
    <p class="lp-lede">{s.hero.lede}</p>
    <div class="cta-row lp-ctas">
      <a class="btn btn-primary btn-large" href={SITE.demo} data-demo>{s.hero.tryDemo} <Icon name="arrow-right" size={18} /></a>
      <a class="btn btn-secondary btn-large" href={NAV.start}>{s.hero.getStarted}</a>
    </div>
    <p class="lp-note">{s.hero.note}</p>
    <p class="lp-app"><a href="https://apps.apple.com/us/app/opentodo/id6832200428"><img src="/badges/app-store.svg" width="120" height="40" alt="Download on the App Store" /></a><span>{s.hero.iosApp}</span></p>
  </div>
  <div class="wrap">
    <div class="lp-stage" id="tour">
      <div class="lp-slides">
        {slides.map((sl, i) => (
          <figure class="lp-slide" style={`--i: ${i}`}>
            <ScreenshotFrame shot={sl.shot} alt={sl.alt} frame="none" eager={i === 0} class="lp-shot" sizes="(min-width: 1200px) 1100px, 100vw" />
            <figcaption>{sl.caption}</figcaption>
          </figure>
        ))}
      </div>
      <div class="lp-phone" aria-hidden="true">
        <ScreenshotFrame shot="mobile-dark" alt="" frame="none" sizes="(min-width: 1024px) 240px, 0px" />
      </div>
    </div>
  </div>
</section>

{translated && <LangNote lang={lang as any} />}

<section class="lp-sec" id="day" aria-labelledby="day-title">
  <div class="wrap">
    <h2 id="day-title">{s.day.h2}</h2>
    <ul class="lp-trio">
      {dayRows.map((d) => (
        <li>
          <Icon name={d.icon} size={20} />
          <h3><a href={d.doc}>{d.title}</a></h3>
          <p>{d.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="lp-sec lp-band" id="features" aria-labelledby="features-title">
  <div class="wrap">
    <div class="lp-split">
      <div>
        <h2 id="features-title">{s.features.h2}</h2>
        <p class="lp-intro">{fill(s.features.intro, { count, groups: groups.length })}</p>
        <a class="link-arrow" href="/features/">{s.features.all} <Icon name="arrow-right" size={16} /></a>
      </div>
      <div>
        <ul class="lp-groups">
          {groups.map((g) => <li><a href={`/features/${g.key}/`}><Icon name={g.icon} size={18} /><span>{groupTitle(g.key, g.title)}</span><span class="count">{g.items.length}</span></a></li>)}
        </ul>
        <dl class="lp-strips">
          <div><dt>{s.features.connects}</dt><dd lang={enLang}>{integrations().join(' · ')}</dd></div>
          <div><dt>{s.features.imports}</dt><dd lang={enLang}>{importApps().join(' · ')}</dd></div>
        </dl>
      </div>
    </div>
  </div>
</section>

<section class="lp-sec" id="yours" aria-labelledby="yours-title">
  <div class="wrap lp-split">
    <div>
      <h2 id="yours-title">{s.yours.h2}</h2>
      <p class="lp-intro" set:html={s.yours.intro} />
    </div>
    <ul class="rows">
      {yours.map((y) => <li><Icon name={y.icon} size={18} /><div><h3 class="row-title"><a href={y.href}>{y.title}</a></h3><p class="row-line">{y.text}</p></div><span /></li>)}
    </ul>
  </div>
</section>

<section class="lp-sec lp-band" id="get-it" aria-labelledby="get-it-title">
  <div class="wrap">
    <h2 id="get-it-title">{s.ways.h2}</h2>
    <p class="lp-intro">{s.ways.intro}</p>
    <ol class="lp-ways" id="self-host">
      {ways.map((w) => (
        <li>
          <Icon name={w.icon} size={20} />
          <h3>{w.title}</h3>
          <p>{w.text}</p>
          <a class:list={['btn', w.primary ? 'btn-primary' : 'btn-secondary']} href={w.href}>{w.cta}</a>
          <a class="lp-more" href={w.moreHref}>{w.more}</a>
        </li>
      ))}
    </ol>
    <p class="lp-switch"><Icon name="folder-input" size={16} /> {s.ways.switch} <a href="/start/#switch">{s.ways.switchLink}</a></p>
  </div>
</section>

<section class="lp-sec" id="community" aria-labelledby="community-title">
  <div class="wrap lp-community">
    <div>
      <h2 id="community-title">{s.community.h2}</h2>
      <p class="lp-intro">{s.community.intro}</p>
    </div>
    <DiscordButton label={s.community.button} />
  </div>
</section>

<section class="lp-end" id="blog" aria-labelledby="end-title">
  <div class="wrap">
    <h2 id="end-title">{s.end.h2}</h2>
    <div class="cta-row lp-ctas"><a class="btn btn-primary btn-large" href={SITE.demo} data-demo>{s.hero.tryDemo} <Icon name="arrow-right" size={18} /></a><a class="btn btn-secondary btn-large" href={NAV.start}>{s.hero.getStarted}</a></div>
    {latestPosts.length > 0 && (
      <div class="lp-news" lang={enLang}>
        <h3>{s.end.news}</h3>
        <ol class="post-rows">{latestPosts.map((p) => <PostRow post={p} headingLevel={3} />)}</ol>
        <p class="meta"><a href="/blog/">{s.end.allPosts}</a> · <a href={SITE.appRepo} data-star>{s.end.star}</a></p>
      </div>
    )}
  </div>
</section>
