---
// One post as a row (website-blog-compact D1): the date, the title with its one-line summary,
// and the category (or `label`, a series page's part number). Used by the index, the category
// pages, a series page and a post's related posts.
import { CATEGORY_LABELS, formatDate, isoDate, type Post } from '../../lib/blog';

interface Props { post: Post; headingLevel?: 2 | 3; label?: string }
const { post, headingLevel = 2, label } = Astro.props;
const d = post.data;
const H = `h${headingLevel}` as 'h2' | 'h3';
const dev = d.inDevelopment && !d.shippedIn;
---
<li class="post-row">
  <time datetime={isoDate(d.publishedAt)}>{formatDate(d.publishedAt)}</time>
  <div>
    <H class="post-row-title"><a href={`/blog/${post.id}/`}>{d.title}</a></H>
    <p>{d.summary}</p>
  </div>
  <span class="post-row-cat">{label ?? (dev ? 'In development' : CATEGORY_LABELS[d.category])}</span>
</li>
