---
// A page of posts, the index or a category (website-blog-compact D1): one row per post.
// Plain links for pagination, so it works without JavaScript.
import Base from '../../layouts/Base.astro';
import EndCta from '../EndCta.astro';
import Icon from '../Icon.astro';
import CategoryNav from './CategoryNav.astro';
import PostRow from './PostRow.astro';
import type { Category, Post } from '../../lib/blog';

interface Props {
  title: string; heading: string; lede?: string; description: string;
  posts: Post[]; page: number; pages: number; base: string; category?: Category; featureFirst?: boolean;
}
const { title, heading, description, posts, page, pages, base, category } = Astro.props;
const pageUrl = (n: number) => (n === 1 ? base : `${base}page/${n}/`);
---
<Base title={page > 1 ? `${title}, page ${page}` : title} description={description}>
  <link slot="head" rel="alternate" type="application/rss+xml" title="OpenTodo blog" href="/blog/feed.xml" />
  <section class="page-head blog-head">
    <div class="wrap">
      <h1>{heading}</h1>
      <CategoryNav current={category} />
    </div>
  </section>
  <section class="blog-list" aria-label="Posts">
    <div class="wrap">
      {posts.length === 0 && <p class="muted">No posts here yet.</p>}
      {posts.length > 0 && <ol class="post-rows">{posts.map((p) => <PostRow post={p} />)}</ol>}
      {pages > 1 && (
        <nav class="pager" aria-label="Pages">
          {page > 1 ? <a class="btn btn-secondary" href={pageUrl(page - 1)} rel="prev"><Icon name="arrow-left" size={18} /> Newer posts</a> : <span />}
          <span class="muted">Page {page} of {pages}</span>
          {page < pages ? <a class="btn btn-secondary" href={pageUrl(page + 1)} rel="next">Older posts <Icon name="arrow-right" size={18} /></a> : <span />}
        </nav>
      )}
    </div>
  </section>
  <EndCta kind="follow" />
</Base>
