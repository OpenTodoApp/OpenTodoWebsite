---
// A post's cover as a responsive <picture> (AVIF and WebP). Without a cover, a card
// passes the post's title and gets a typographic cover on the category's tint
// (website-section-system D5); the post page itself shows no cover then.
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import type { Category } from '../../lib/blog';

interface Props { cover?: ImageMetadata; alt?: string; category: Category; sizes: string; eager?: boolean; class?: string; title?: string }
const { cover, alt = '', category, sizes, eager = false, class: className, title } = Astro.props;
// Three sizes, so a short title fills the cover and a long one still fits.
const size = !title ? '' : title.length <= 28 ? 'size-l' : title.length <= 56 ? 'size-m' : 'size-s';

let sources: { type: string; srcset: string }[] = [];
let fallback: { src: string } | undefined;
if (cover) {
  const widths = [400, 640, 960, 1280, 1600].filter((w) => w <= cover.width);
  sources = await Promise.all((['avif', 'webp'] as const).map(async (format) => ({ type: `image/${format}`, srcset: (await getImage({ src: cover, widths, format, quality: format === 'avif' ? 55 : 72 })).srcSet.attribute })));
  fallback = await getImage({ src: cover, width: Math.min(960, cover.width), format: 'webp' });
}
---
{cover && fallback ? (
  <picture class:list={['post-cover', className]}>
    {sources.map((s) => <source type={s.type} srcset={s.srcset} sizes={sizes} />)}
    <img src={fallback.src} width={cover.width} height={cover.height} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
  </picture>
) : (
  title && <div class:list={['post-cover', 'post-cover-type', `cat-${category}`, className]} aria-hidden="true"><span class:list={['post-cover-title', size]}>{title}</span></div>
)}
