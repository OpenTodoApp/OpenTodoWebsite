---
import { SITE } from '../lib/site';
import CoffeeButton from './CoffeeButton.astro';
import { versionTag } from '../lib/bundle';
import { getCollection } from 'astro:content';
import { publishedPosts } from '../lib/blog';
import { footerColumns } from '../lib/nav';
import { DEFAULT_LANG, LANGS, alternatesFor, localePath } from '../i18n/index.mjs';
interface Props { lang?: keyof typeof LANGS }
const { lang = DEFAULT_LANG } = Astro.props;
const blog = (await publishedPosts()).length > 0;
const published = async (c: 'templates' | 'guides') =>
  (await getCollection(c, (e) => !('draft' in e.data) || !e.data.draft)).length > 0;
const content = (await published('templates')) && (await published('guides'));
// Four columns from the shared navigation model (website-navigation-and-home D1).
const columns = footerColumns({ content, blog });
// This page in every language when it is translated; otherwise each language's home page (website-languages D4).
const languages = alternatesFor(Astro.url.pathname) ?? Object.keys(LANGS).map((l) => ({ lang: l, href: localePath('/', l), ...LANGS[l as keyof typeof LANGS] }));
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <a class="brand" href="/"><img src="/assets/favicon.svg" width="24" height="24" alt="" /><span>OpenTodo</span></a>
        <p>An open-source task manager you host yourself. This site describes OpenTodo {versionTag}, the latest release.</p>
        <p class="footer-coffee"><CoffeeButton small /></p>
      </div>
      {columns.map((c) => (
        <nav aria-label={c.title}>
          <h2>{c.title}</h2>
          <ul>
            {c.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </nav>
      ))}
    </div>
    <nav class="footer-langs" aria-label="Languages">
      <ul>
        {languages.map((l) => <li><a href={l.href} hreflang={l.hreflang} lang={l.hreflang} aria-current={l.lang === lang ? 'page' : undefined}>{l.name}</a></li>)}
      </ul>
    </nav>
    <p class="footer-fine">
      <span class="footer-legal">
        <a href={`${SITE.appRepo}/blob/main/LICENSE`}>App: AGPL-3.0</a>
        <a href={`${SITE.siteRepo}/blob/main/LICENSE`}>Website code: MIT</a>
        <a href={`${SITE.siteRepo}/blob/main/LICENSE-CONTENT.md`}>Words and images: CC BY 4.0</a>
        <a href={`${SITE.appRepo}/blob/main/SECURITY.md`}>Security</a>
      </span>
      © {year} the OpenTodo contributors. Product names of other apps are used to identify them only. This website (not the app) counts visits with self-hosted Umami: no cookies, no personal data.</p>
  </div>
</footer>
