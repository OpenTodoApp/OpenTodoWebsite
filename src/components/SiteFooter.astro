---
// Footer (website-restyle-chrome D3): the brand line and the language switch, three short link
// groups, one quiet row of ways to support and follow the project, and one line of licences.
// Below 768 px the three groups show as disclosures that open without JavaScript.
import { NAV, SITE } from '../lib/site';
import Icon from './Icon.astro';
import LangSwitch from './LangSwitch.astro';
import { versionTag } from '../lib/bundle';
import { publishedPosts } from '../lib/blog';
const blog = (await publishedPosts()).length > 0;
const year = new Date().getFullYear();
const groups: [string, [string, string][]][] = [
  ['Product', [['Features', NAV.features], ['Get started', NAV.start], ['Install the app', '/install/'], ['Self-host', '/self-host/'], ['Templates', '/templates/'], ['Changelog', '/changelog/']]],
  ['Learn', [['Guides and how-tos', NAV.learn], ['Docs', '/docs/'], ['Under the hood', '/under-the-hood/'], ['Moving from another app', '/switch/'], ...(blog ? [['Blog', '/blog/'] as [string, string]] : [])]],
  ['Project', [['About', '/about/'], ['Support OpenTodo', '/support/'], ['Demo status', '/status/'], ['Security', '/security/'], ['Accessibility', '/accessibility/'], ['Privacy', '/privacy/']]],
];
// Ways to help and follow (website-restyle-chrome D4): plain text links, nothing loaded from the services.
const community: { label: string; href: string; icon: string; data: string }[] = [
  { label: 'Star on GitHub', href: SITE.appRepo, icon: 'star', data: 'data-star' },
  { label: 'Sponsor', href: SITE.sponsor, icon: 'heart', data: 'data-sponsor' },
  { label: 'Buy me a coffee', href: SITE.coffee, icon: 'coffee', data: 'data-coffee' },
  { label: 'Discord', href: SITE.discord, icon: 'messages-square', data: 'data-discord' },
  { label: 'X', href: SITE.x, icon: 'at-sign', data: 'data-x' },
  { label: 'RSS', href: '/feed.xml', icon: 'rss', data: 'data-rss' },
];
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-top">
      <div class="footer-brand">
        <a class="brand" href="/"><img src="/assets/favicon.svg" width="24" height="24" alt="" /><span>OpenTodo</span></a>
        <p>The task manager you host yourself. Free and open source.</p>
        <LangSwitch up />
      </div>
      {groups.map(([title, items]) => (
        <nav aria-label={title} class="footer-group">
          <h2>{title}</h2>
          <ul>
            {items.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
          </ul>
        </nav>
      ))}
      <div class="footer-fold">
        {groups.map(([title, items]) => (
          <nav aria-label={title}>
            <details>
              <summary><span>{title}</span><Icon name="chevron-down" size={16} class="chev" /></summary>
              <ul>
                {items.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
              </ul>
            </details>
          </nav>
        ))}
      </div>
    </div>
    <nav class="footer-community" aria-label="Community">
      <ul>
        {community.map((c) => <li><a href={c.href} {...{ [c.data]: '' }}><Icon name={c.icon} size={16} />{c.label}</a></li>)}
      </ul>
    </nav>
    <p class="footer-legal">
      <span>© {year} the OpenTodo contributors</span>
      <span>OpenTodo {versionTag}</span>
      <a href={`${SITE.appRepo}/blob/main/LICENSE`}>App AGPL-3.0</a>
      <a href={`${SITE.siteRepo}/blob/main/LICENSE`}>Site MIT</a>
      <a href={`${SITE.siteRepo}/blob/main/LICENSE-CONTENT.md`}>Content CC BY 4.0</a>
      <a href={SITE.siteRepo}>Site source</a>
      <span>Visits counted with self-hosted Umami, no cookies.</span>
    </p>
  </div>
</footer>
