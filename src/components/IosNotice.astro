---
// The iPhone and iPad app in the App Store (first release, approved 2026-11-09). The badge leads
// to /apps/, which links the store (phone-apps-page).
import { p as strings, href as hrefIn } from '../i18n/path/index.mjs';

interface Props { lang?: 'en' | 'de' }
const { lang = 'en' } = Astro.props;
const s = strings(lang).notices;
---
<aside class="post-notice" aria-label={s.iosLabel}>
  <p><a href={hrefIn(lang)('/apps/')}><img src="/badges/app-store.svg" height="40" width="120" alt={s.iosBadge}></a></p>
  <!-- no-claim -->
  <p set:html={s.ios} />
</aside>
