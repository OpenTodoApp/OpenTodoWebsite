---
// Main navigation (website-platform "Shared layout and navigation", website-first-visit D4,
// website-navigation-and-home D1–D3). From 768 px: Features, Compare, What it costs,
// Self-host, a Resources <details> menu and Docs, a GitHub icon link and one button.
// Below 768 px: one <details> menu with the same links in two groups. Both open
// without JavaScript. The links come from src/lib/nav.ts.
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import { SITE } from '../lib/site';
import { publishedPosts } from '../lib/blog';
import { headerLinks, resourceLinks } from '../lib/nav';

const path = Astro.url.pathname;
const published = async (c: 'templates' | 'guides') =>
  (await getCollection(c, (e) => !('draft' in e.data) || !e.data.draft)).length > 0;
// Templates and Guides appear once at least one of each is published (website-content spec).
const content = (await published('templates')) && (await published('guides'));
// Blog appears once a post is published (website-blog spec "Blog in navigation").
const blog = (await publishedPosts()).length > 0;

const { before, after } = headerLinks();
const resources = resourceLinks({ content, blog });
const current = (m: string | null) => (m && path.startsWith(m) ? 'page' : undefined);
const inResources = resources.some((l) => current(l.match));
---
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/">
      <img src="/assets/favicon.svg" width="28" height="28" alt="" />
      <span>OpenTodo</span>
    </a>
    <nav class="nav-desktop" aria-label="Main">
      <ul>
        {before.map((l) => <li><a class="nav-link" href={l.href} aria-current={current(l.match)}>{l.label}</a></li>)}
        <li>
          <details class="nav-group">
            <summary class="nav-link" aria-current={inResources ? 'page' : undefined}>Resources <Icon name="chevron-down" size={16} /></summary>
            <ul class="nav-group-panel">
              {resources.map((l) => <li><a class="nav-link" href={l.href} aria-current={current(l.match)}>{l.label}</a></li>)}
            </ul>
          </details>
        </li>
        {after.map((l) => <li><a class="nav-link" href={l.href} aria-current={current(l.match)}>{l.label}</a></li>)}
      </ul>
    </nav>
    <a class="header-gh header-cta" href={SITE.appRepo} aria-label="OpenTodo on GitHub" title="OpenTodo on GitHub" data-star><Icon name="code" size={20} /></a>
    <a class="btn btn-primary btn-small header-cta" href={SITE.demo}>Try the demo</a>
    <details class="nav-menu">
      <summary><Icon name="menu" size={18} /> Menu</summary>
      <div class="menu-panel">
        <nav aria-label="Main">
          <p class="menu-group">Product</p>
          <ul>
            {[...before, ...after].map((l) => <li><a class="nav-link" href={l.href} aria-current={current(l.match)}>{l.label}</a></li>)}
          </ul>
          <p class="menu-group">Resources</p>
          <ul>
            {resources.map((l) => <li><a class="nav-link" href={l.href} aria-current={current(l.match)}>{l.label}</a></li>)}
          </ul>
        </nav>
        <div class="menu-cta">
          <a class="btn btn-primary" href={SITE.demo}>Try the demo</a>
          <a class="btn btn-secondary" href={SITE.appRepo} data-star><Icon name="code" size={18} /> OpenTodo on GitHub</a>
        </div>
      </div>
    </details>
  </div>
</header>
