---
// Main navigation (website-platform "Shared layout and navigation", marketing-website
// "Five-destination navigation", website-shell-v2). Five links, a secondary "Try the demo"
// and a primary "Get started"; below 768 px one <details> menu holds the same, so it
// opens without JavaScript.
import Icon from './Icon.astro';
import { NAV, SITE } from '../lib/site';
import { publishedPosts } from '../lib/blog';

const path = Astro.url.pathname;
// Blog appears once a post is published (website-blog spec "Blog in navigation").
const blog = (await publishedPosts()).length > 0;

interface Link { href: string; label: string; match: string[] }
// Learn is current on the guidance pages it gathers (website-shell-v2 D1).
const links: Link[] = [
  { href: NAV.features, label: 'Features', match: ['/features/'] },
  { href: NAV.learn, label: 'Learn', match: ['/learn/', '/help/', '/guides/', '/how-to/', '/toolkit/', '/topics/', '/templates/', '/switch/'] },
  { href: '/vs/', label: 'Compare', match: ['/vs/'] },
  { href: '/docs/', label: 'Docs', match: [] },
  ...(blog ? [{ href: '/blog/', label: 'Blog', match: ['/blog/'] }] : []),
];
const current = (l: Link) => (l.match.some((m) => path.startsWith(m)) ? 'page' : undefined);
---
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/">
      <img src="/assets/favicon.svg" width="28" height="28" alt="" />
      <span>OpenTodo</span>
    </a>
    <nav class="nav-desktop" aria-label="Main">
      <ul>
        {links.map((l) => <li><a class="nav-link" href={l.href} aria-current={current(l)}>{l.label}</a></li>)}
      </ul>
    </nav>
    <a class="btn btn-secondary btn-small header-cta header-star" href={SITE.appRepo} data-star><Icon name="star" size={16} /> Star on GitHub</a>
    <a class="btn btn-secondary btn-small header-cta header-demo" href={SITE.demo}>Try the demo</a>
    <a class="btn btn-primary btn-small header-cta" href={NAV.start}>Get started</a>
    <details class="nav-menu">
      <summary><Icon name="menu" size={18} /> Menu</summary>
      <div class="menu-panel">
        <nav aria-label="Main">
          <ul>
            {links.map((l) => <li><a class="nav-link" href={l.href} aria-current={current(l)}>{l.label}</a></li>)}
          </ul>
        </nav>
        <div class="menu-cta">
          <a class="btn btn-primary" href={NAV.start}>Get started</a>
          <a class="btn btn-secondary" href={SITE.demo}>Try the demo</a>
          <a class="btn btn-secondary" href={SITE.appRepo} data-star><Icon name="star" size={18} /> Star on GitHub</a>
        </div>
      </div>
    </details>
  </div>
</header>
