---
// Main navigation (website-restyle-chrome D1, hosting-page D3): five destinations, the language switch, a
// GitHub star and one primary action, Try the demo. Below 960 px one <details> menu holds the
// links and the language switch, so it opens without JavaScript; the demo stays visible.
import { BRAND } from '../lib/brand';
import Icon from './Icon.astro';
import LangSwitch from './LangSwitch.astro';
import MsTodoLink from './MsTodoLink.astro';
import { NAV, SITE } from '../lib/site';
import { publishedPosts } from '../lib/blog';
import { splitLang } from '../i18n/index.mjs';
import { chromeLabel, href as hrefIn } from '../i18n/path/index.mjs';

const path = Astro.url.pathname;
// German pages get a German header whose links lead to German pages where they exist (german-pages).
// Every language gets the Microsoft To Do link's own text; the rest of the header is English or German.
const [lang] = splitLang(path);
const t = chromeLabel(lang);
const to = hrefIn(lang as 'en' | 'de');
const english = splitLang(path)[1];
// Blog appears once a post is published (website-blog spec "Blog in navigation").
const blog = (await publishedPosts()).length > 0;

interface Link { href: string; label: string; match: string[] }
// Learn is current on the guidance pages it gathers (website-shell-v2 D1).
const links: Link[] = [
  { href: to(NAV.features), label: t('Features'), match: ['/features/'] },
  { href: NAV.learn, label: t('Learn'), match: ['/learn/', '/help/', '/guides/', '/how-to/', '/toolkit/', '/topics/', '/templates/', '/switch/'] },
  { href: '/docs/', label: t('Docs'), match: [] },
  ...(blog ? [{ href: '/blog/', label: t('Blog'), match: ['/blog/'] }] : []),
  // Managed hosting (hosting-page): the site's own page, never PikaPods itself.
  { href: '/hosting/', label: t('Hosting'), match: ['/hosting/'] },
  { href: '/ecosystem/', label: t('Ecosystem'), match: ['/ecosystem/'] },
];
const current = (l: Link) => (l.match.some((m) => english.startsWith(m)) ? 'page' : undefined);
---
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={to('/')}>
      <img src={BRAND.favicon} width="28" height="28" alt="" />
      <span>OpenTodo</span>
    </a>
    <nav class="nav-desktop" aria-label={t('Main')}>
      <ul>
        {links.map((l) => <li><a class="nav-link" href={l.href} aria-current={current(l)}>{l.label}</a></li>)}
      </ul>
    </nav>
    <div class="header-tools">
      <LangSwitch class="header-lang" />
      <a class="header-star" href={SITE.appRepo} data-star><Icon name="star" size={16} /><span>{t('Star')}<span class="visually-hidden"> {t('OpenTodo on GitHub')}</span></span></a>
      <MsTodoLink lang={lang} class="header-ms-todo" />
      <a class="btn btn-primary btn-small header-demo" href={SITE.demo}>{t('Try the demo')}</a>
      <details class="nav-menu">
        <summary><Icon name="menu" size={18} /><span class="visually-hidden">{t('Menu')}</span></summary>
        <div class="menu-panel">
          <nav aria-label={t('Main')}>
            <ul>
              {links.map((l) => <li><a class="nav-link" href={l.href} aria-current={current(l)}>{l.label}</a></li>)}
              <li><a class="nav-link" href={to(NAV.start)}>{t('Get started')}</a></li>
              <li><a class="nav-link" href={SITE.appRepo} data-star><Icon name="star" size={18} /> {t('Star on GitHub')}</a></li>
              <MsTodoLink lang={lang} item />
            </ul>
          </nav>
          <LangSwitch />
        </div>
      </details>
    </div>
  </div>
</header>
