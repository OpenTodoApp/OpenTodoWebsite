---
// Main navigation (website-restyle-chrome D1): four destinations, the language switch, a
// GitHub star and one primary action, Try the demo. Below 768 px one <details> menu holds the
// links and the language switch, so it opens without JavaScript; the demo stays visible.
import Icon from './Icon.astro';
import LangSwitch from './LangSwitch.astro';
import { NAV, SITE } from '../lib/site';
import { publishedPosts } from '../lib/blog';

const path = Astro.url.pathname;
// Blog appears once a post is published (website-blog spec "Blog in navigation").
const blog = (await publishedPosts()).length > 0;

interface Link { href: string; label: string; match: string[] }
// Learn is current on the guidance pages it gathers (website-shell-v2 D1).
const links: Link[] = [
  { href: NAV.features, label: 'Features', match: ['/features/'] },
  { href: NAV.learn, label: 'Learn', match: ['/learn/', '/help/', '/guides/', '/how-to/', '/toolkit/', '/topics/', '/templates/', '/switch/'] },
  { href: '/docs/', label: 'Docs', match: [] },
  ...(blog ? [{ href: '/blog/', label: 'Blog', match: ['/blog/'] }] : []),
];
const current = (l: Link) => (l.match.some((m) => path.startsWith(m)) ? 'page' : undefined);
---
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/">
      <img src="/assets/favicon.svg" width="28" height="28" alt="" />
      <span>OpenTodo</span>
    </a>
    <nav class="nav-desktop" aria-label="Main">
      <ul>
        {links.map((l) => <li><a class="nav-link" href={l.href} aria-current={current(l)}>{l.label}</a></li>)}
      </ul>
    </nav>
    <div class="header-tools">
      <LangSwitch class="header-lang" />
      <a class="header-star" href={SITE.appRepo} data-star><Icon name="star" size={16} /><span>Star<span class="visually-hidden"> OpenTodo on GitHub</span></span></a>
      <a class="btn btn-primary btn-small header-demo" href={SITE.demo}>Try the demo</a>
      <details class="nav-menu">
        <summary><Icon name="menu" size={18} /><span class="visually-hidden">Menu</span></summary>
        <div class="menu-panel">
          <nav aria-label="Main">
            <ul>
              {links.map((l) => <li><a class="nav-link" href={l.href} aria-current={current(l)}>{l.label}</a></li>)}
              <li><a class="nav-link" href={NAV.start}>Get started</a></li>
              <li><a class="nav-link" href={SITE.appRepo} data-star><Icon name="star" size={18} /> Star on GitHub</a></li>
            </ul>
          </nav>
          <LangSwitch />
        </div>
      </details>
    </div>
  </div>
</header>
