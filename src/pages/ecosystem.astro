---
// /ecosystem (apps-and-ecosystem D2): everything that installs OpenTodo or connects to it, as rows
// of links into the pinned docs, each with its status on the right. A status changes here when a
// store lists OpenTodo or a package is released; nothing unreleased is listed as available.
import Base from '../layouts/Base.astro';
import EndCta from '../components/EndCta.astro';
import LinkRows, { type LinkRow } from '../components/LinkRows.astro';

const AVAILABLE = 'Available';
const REVIEW = 'Submitted, in review';
const sh = (p: string) => `/docs/self-hosting/${p}/`;

const servers: LinkRow[] = [
  { icon: 'container', title: 'Docker and Podman', href: sh('docker'), line: 'One container and one volume, on any Linux, Mac or Windows machine. <a href="/docs/self-hosting/podman/">Podman</a>', note: AVAILABLE, actions: [{ label: 'Releases', href: 'https://github.com/OpenTodoApp/OpenTodo/releases' }] },
  { icon: 'house', title: 'Home Assistant add-on', href: sh('home-assistant-addon'), line: 'On Home Assistant OS or Supervised, from OpenTodo’s add-on repository.', note: AVAILABLE, actions: [{ label: 'Add the repository', href: 'https://my.home-assistant.io/redirect/supervisor_add_addon_repository/?repository_url=https%3A%2F%2Fgithub.com%2FOpenTodoApp%2Fopentodo-homeassistant-addons' }] },
  { icon: 'hard-drive', title: 'TrueNAS', href: sh('truenas'), line: 'In the Apps catalogue, community train, or with Install via YAML.', note: AVAILABLE, actions: [{ label: 'Catalogue entry', href: 'https://github.com/truenas/apps/tree/master/ix-dev/community/opentodo' }] },
  { icon: 'hard-drive', title: 'Unraid', href: sh('unraid'), line: 'Listed in Community Applications.', note: AVAILABLE, actions: [{ label: 'Template', href: 'https://github.com/OpenTodoApp/opentodo-unraid' }] },
  { icon: 'hard-drive', title: 'Synology', href: sh('synology'), line: 'A Container Manager project on DSM.', note: AVAILABLE, actions: [{ label: 'Project files', href: 'https://github.com/OpenTodoApp/OpenTodo/tree/main/deploy/synology' }] },
  { icon: 'package', title: 'Runtipi', href: sh('runtipi'), line: 'From OpenTodo’s own app store for Runtipi.', note: AVAILABLE, actions: [{ label: 'App store', href: 'https://github.com/OpenTodoApp/opentodo-runtipi' }] },
  { icon: 'layers', title: 'Portainer', href: sh('portainer'), line: 'From its Portainer app template, or as one container.', note: AVAILABLE, actions: [{ label: 'Template list', href: 'https://raw.githubusercontent.com/OpenTodoApp/OpenTodo/main/deploy/portainer/portainer-template.json' }, { label: 'Lissy93 templates', href: 'https://portainer-templates.as93.net/opentodo' }] },
  { icon: 'server', title: 'Coolify', href: sh('coolify'), line: 'As a Docker Compose service. The one-click template waits for the stars Coolify asks for.', note: AVAILABLE, actions: [{ label: 'Compose file', href: 'https://github.com/OpenTodoApp/OpenTodo/tree/main/deploy/coolify' }] },
  { icon: 'waypoints', title: 'Kubernetes (Helm)', href: sh('kubernetes'), line: 'A Helm chart with one replica and a persistent volume.', note: AVAILABLE, actions: [{ label: 'Chart', href: 'https://github.com/OpenTodoApp/OpenTodo/tree/main/deploy/helm' }] },
  { icon: 'server', title: 'Fly.io', href: sh('fly'), line: 'One machine with a volume.', note: AVAILABLE, actions: [{ label: 'fly.toml', href: 'https://github.com/OpenTodoApp/OpenTodo/blob/main/deploy/fly/fly.toml' }] },
  { icon: 'server', title: 'Render', href: sh('render'), line: 'A web service with a disk, from a blueprint.', note: AVAILABLE, actions: [{ label: 'Deploy to Render', href: 'https://render.com/deploy?repo=https://github.com/OpenTodoApp/OpenTodo&path=deploy/render/render.yaml' }] },
  { icon: 'package', title: 'Umbrel', href: sh('umbrel'), line: 'Submitted to the Umbrel App Store.', note: REVIEW, actions: [{ label: 'Follow the review', href: 'https://github.com/getumbrel/umbrel-apps/pull/6251' }] },
  { icon: 'package', title: 'CasaOS and ZimaOS', href: sh('casaos'), line: 'Submitted to the app store. Until it is listed, install it as a custom app.', note: REVIEW, actions: [{ label: 'Follow the review', href: 'https://github.com/IceWhaleTech/CasaOS-AppStore/pull/1104' }] },
  { icon: 'package', title: 'Easypanel', href: sh('easypanel'), line: 'Template submitted. Until it is listed, set the service up by hand.', note: REVIEW, actions: [{ label: 'Follow the review', href: 'https://github.com/easypanel-io/templates/pull/1702' }] },
  { icon: 'package', title: 'Cosmos', href: sh('cosmos'), line: 'Submitted to the Cosmos market. Until it is listed, use a custom compose.', note: REVIEW, actions: [{ label: 'Follow the review', href: 'https://github.com/azukaar/cosmos-servapps-official/pull/329' }] },
  { icon: 'package', title: 'Dokploy', href: sh('dokploy'), line: 'Template submitted to the catalogue. Until then, a Compose service.', note: REVIEW, actions: [{ label: 'Follow the review', href: 'https://github.com/Dokploy/templates/pull/1315' }] },
  { icon: 'package', title: 'CapRover', href: sh('caprover'), line: 'Paste the template. It is not in the one-click list yet.', note: 'Template ready', actions: [{ label: 'Template', href: 'https://github.com/OpenTodoApp/OpenTodo/tree/main/deploy/caprover' }] },
];

const apps: LinkRow[] = [
  { icon: 'monitor-smartphone', title: 'Web app', href: '/apps/', line: 'The full app, installed from your browser on any phone or computer. Works offline. <a href="/docs/install-app/">Installing the app</a>', note: 'Recommended' },
  { icon: 'smartphone', title: 'iPhone and iPad', href: '/apps/', line: 'A first release in the App Store. <a href="/docs/install-phone/#the-ios-app">The iOS app</a>', note: 'App Store', actions: [{ label: 'App Store', href: 'https://apps.apple.com/us/app/opentodo/id6832200428' }] },
  { icon: 'smartphone', title: 'Android', href: '/docs/android-app/', line: 'From GitHub for now. Google Play is in closed testing, F-Droid inclusion is requested.', note: 'GitHub', actions: [{ label: 'Download', href: 'https://github.com/OpenTodoApp/OpenTodo/releases/latest' }] },
];

const integrations: LinkRow[] = [
  { icon: 'notebook-pen', title: 'Obsidian plugin', href: '/docs/obsidian/', line: 'Send a line or a selection from a note as tasks. Install it by hand or with BRAT; it is not in Obsidian’s plugin list yet.', note: 'By hand or BRAT', actions: [{ label: 'Releases', href: 'https://github.com/OpenTodoApp/obsidian-opentodo/releases' }] },
  { icon: 'bot', title: 'Claude Code plugin', href: '/docs/claude/', line: 'Install it from OpenTodo’s plugin marketplace.', note: AVAILABLE, actions: [{ label: 'Plugin', href: 'https://github.com/OpenTodoApp/opentodo-claude' }] },
  { icon: 'sparkles', title: 'MCP for AI assistants', href: '/docs/mcp/', line: 'Claude, ChatGPT, Gemini and others read your tasks, and change them only when you allow it.', note: AVAILABLE },
  { icon: 'terminal', title: 'The ot command line', href: '/docs/cli/', line: 'Add, list and change tasks from a terminal or a script.', note: AVAILABLE, actions: [{ label: 'Download', href: 'https://github.com/OpenTodoApp/OpenTodo/releases/latest' }] },
  { icon: 'globe', title: 'Browser extension', href: '/docs/capture/', line: 'Save pages, selections and screenshots from Chromium and Firefox. Not in the browser stores yet.', note: 'From source', actions: [{ label: 'Download', href: 'https://github.com/OpenTodoApp/OpenTodo/releases/latest' }, { label: 'Source', href: 'https://github.com/OpenTodoApp/OpenTodo/tree/main/extension' }] },
  { icon: 'calendar-sync', title: 'CalDAV', href: '/docs/caldav/', line: 'Apple Reminders, Thunderbird, and DAVx⁵ with Tasks.org on Android.', note: AVAILABLE },
  { icon: 'calendar-days', title: 'Calendar sync', href: '/docs/calendar-sync/', line: 'Your dated tasks as events in Google, Microsoft or a CalDAV calendar, and changes back.', note: AVAILABLE },
  { icon: 'house', title: 'Home Assistant integration', href: '/docs/home-assistant/', line: 'Your lists as to-do lists, counts, a calendar and events. Installs through HACS as a custom repository.', note: 'HACS', actions: [{ label: 'Open in HACS', href: 'https://my.home-assistant.io/redirect/hacs_repository/?owner=OpenTodoApp&repository=opentodo-homeassistant&category=integration' }] },
  { icon: 'webhook', title: 'Webhooks', href: '/docs/webhooks/', line: 'Signed events for task and project changes, with retries.', note: AVAILABLE },
  { icon: 'folder-input', title: 'Importers', href: '/docs/import/', line: 'Your own export, CSV and other apps’ exports. <a href="/switch/">Moving from another app</a>', note: AVAILABLE },
];
---
<Base title="Ecosystem" description="Everything that installs OpenTodo or connects to it: servers and NAS app stores, the apps, plugins and integrations, with where each one stands.">
  <section class="page-head tech-head">
    <div class="wrap narrow">
      <h1>Ecosystem</h1>
    </div>
  </section>
  <div class="wrap narrow tech-body">
    <LinkRows id="servers" title="Install it on your server or NAS" items={servers} />
    <LinkRows id="apps" title="Apps" items={apps} />
    <LinkRows id="integrations" title="Plugins and integrations" items={integrations} />
  </div>
  <EndCta kind="source" />
</Base>
