---
// /topics (website-templates-and-methods D5): one card per topic.
import Base from '../../layouts/Base.astro';
import Close from '../../components/sections/Close.astro';
import Icon from '../../components/Icon.astro';
import { TOPICS } from '../../lib/topics.mjs';
---
<Base title="Topics" description="Everything on the site by topic: task management, time management, habits and routines, working together, owning your data. Guides, templates, how-tos and posts in one place.">
  <section class="page-head">
    <div class="wrap">
      <p class="kicker">Topics</p>
      <h1>Everything on one subject, in one place.</h1>
      <p class="lede">Each topic collects the guides, templates, how-tos and posts that belong to it, so you can go deep on one thing without hunting.</p>
    </div>
  </section>
  <section class="section" style="padding-top: 1rem">
    <div class="wrap">
      <ul class="grid grid-3 plain">
        {TOPICS.map((t) => <li><a class="card" href={`/topics/${t.slug}/`}><span class="card-icon"><Icon name={t.icon} size={22} /></span><h2 style="font-size: 1.2rem">{t.title}</h2><p>{t.lede}</p></a></li>)}
      </ul>
    </div>
  </section>
  <Close />
</Base>
