---
// /cost (website-first-visit D2): what using OpenTodo costs, in words and never
// in currency (content/VOICE.md). The footprint comes from the bundle manifest,
// so the figures follow the pinned release.
import Base from '../layouts/Base.astro';
import EndCta from '../components/EndCta.astro';
import Icon from '../components/Icon.astro';
import { manifest, versionTag } from '../lib/bundle';

const f = manifest.facts;
const licence = f.license ?? 'AGPL-3.0';
// Only the facts the pinned bundle carries are shown (nothing is invented).
const facts = [
  f.imageMB ? { label: 'Container image', value: `about ${f.imageMB} MB` } : f.binaryMB && { label: 'Server binary', value: `about ${Math.round(f.binaryMB)} MB` },
  f.idleMemoryMB && { label: 'Memory when idle', value: `about ${f.idleMemoryMB} MB` },
  f.minimumServer && { label: 'Enough server', value: f.minimumServer },
  f.database && { label: 'Database', value: `one ${f.database} file` },
  f.architectures && { label: 'Runs on', value: f.architectures.map((a) => a.replace('linux/', '')).join(' and ') },
].filter(Boolean) as { label: string; value: string }[];
const footprint = [
  f.minimumServer && `${f.minimumServer[0].toUpperCase()}${f.minimumServer.slice(1)} is plenty`,
  f.idleMemoryMB && `it idles at about ${f.idleMemoryMB} MB of memory`,
].filter(Boolean);
const footprintText = footprint.length ? `${footprint.join(', and ').replace(/^./, (c) => c.toUpperCase())}.` : '';

const homes = [
  { icon: 'house', title: 'A machine already at home', text: 'A NAS, an old laptop or a mini PC that is on anyway. It costs you nothing more than it does today, and your tasks never leave the house. Your phone reaches it from outside through the usual ways people reach home servers.' },
  { icon: 'package', title: 'A Raspberry Pi', text: 'A one-off purchase, then a few watts of electricity. OpenTodo ships for its processor, so it runs there like anywhere else.' },
  { icon: 'server', title: 'A small rented server', text: 'The smallest plan of any hosting provider is more than enough; OpenTodo shares it happily with whatever else you run there. That is a monthly cost, but one for the whole household or team, not per person.' },
];
---
<Base title="What OpenTodo costs" description="OpenTodo is free and open source. You pay only for the server it runs on, described in words: a machine at home, a Raspberry Pi or a small rented server, for everyone who uses it.">
  <section class="page-head">
    <div class="wrap split">
      <div>
        <p class="kicker">What it costs</p>
        <h1>OpenTodo is free. All of it, for everyone, for good.</h1>
        <p class="lede">No plan, no trial, no free tier with limits, no per-person price, no paid feature, for one person or a whole household. It is free software under the {licence} licence, which also means nobody can turn it into a subscription later. The only thing it asks of you is a server to run on, and this page says in words what that server costs and who does the work.</p>
      </div>
      <dl class="facts" aria-label={`Footprint of OpenTodo ${versionTag}`}>
        {facts.map((x) => <div><dt>{x.label}</dt><dd>{x.value}</dd></div>)}
      </dl>
    </div>
    <div class="wrap"><p class="meta" style="margin-top: 1rem">Figures for OpenTodo {versionTag}, from the <a href="/docs/self-hosting/docker/">self-hosting guide</a>.</p></div>
  </section>

  <section class="section section-alt" aria-labelledby="software-title">
    <div class="wrap split">
      <div>
        <h2 id="software-title">The software: free, for one person or a hundred</h2>
        <p class="lede">Every feature is in the one free version: sharing, reminders, boards, filters, calendar, backups, single sign-on, encryption, the API. Nothing unlocks with a payment, and <a href="/docs/sharing/">every person on your server gets their own account</a> at no cost.</p>
      </div>
      <ul class="checks">
        <li><Icon name="check" size={18} /> No subscription, no free tier with limits, no upgrade button anywhere in the app</li>
        <li><Icon name="check" size={18} /> The {licence} licence lets you run, study, change and share it; <a href="/about/#licence">what that means for you</a></li>
        <li><Icon name="check" size={18} /> No account with anyone but your own server; <a href="/docs/offline-and-sync/">your devices talk only to it</a></li>
        <li><Icon name="check" size={18} /> The optional AI assistant uses <a href="/docs/assistant/">your own key with the provider you choose</a>, so any cost there is between you and them, and nothing at all if you leave it off</li>
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="server-title">
    <div class="wrap">
      <div class="section-head">
        <p class="kicker">The server</p>
        <h2 id="server-title">Where it can live</h2>
        <p class="lede">OpenTodo is <a href="/docs/self-hosting/docker/">one container with one folder of data</a>, no database server beside it. {footprintText && `${footprintText} `}The three usual homes, cheapest first:</p>
      </div>
      <div class="grid grid-3">
        {homes.map((h) => (
          <article class="card">
            <span class="card-icon"><Icon name={h.icon} size={22} /></span>
            <h3>{h.title}</h3>
            <p>{h.text}</p>
          </article>
        ))}
      </div>
      <p style="margin-top: 1.5rem"><a class="link-arrow" href="/self-host/plan/">Not sure which? Answer four questions and get the file to run it <Icon name="arrow-right" size={16} /></a> · <a class="link-arrow" href="/self-host/">How to install it, three ways <Icon name="arrow-right" size={16} /></a></p>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="work-title">
    <div class="wrap split">
      <div>
        <p class="kicker">The work</p>
        <h2 id="work-title">One person sets it up. Everyone else just uses an app.</h2>
        <p class="lede">The honest cost of self-hosting is time, and it falls on one person.</p>
      </div>
      <dl class="fine-list">
        <div><dt>The first time</dt><dd>Starting the container and creating the owner account takes a few minutes; giving it an address and HTTPS is the part that takes longer if you have never done it. <a href="/docs/self-hosting/coolify/">Coolify</a> does that part for you.</dd></div>
        <div><dt>Every few weeks</dt><dd>Updating is pulling the new image and restarting; <a href="/docs/self-hosting/docker/#updating">the database updates itself on start</a>. Release notes are on <a href="/whats-new/">What's new</a> and in the <a href="/feed.xml">feed</a>.</dd></div>
        <div><dt>Once, then never again</dt><dd>Turn on <a href="/docs/backups/">scheduled backups</a> to a folder, S3-compatible storage or WebDAV. After that they run on their own.</dd></div>
        <div><dt>Everyone else</dt><dd>Opens the link they were sent, <a href="/docs/install-app/">installs the app from the browser</a> and uses it like any other task app. No setup, no cost, no account with a company.</dd></div>
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="compare-title">
    <div class="wrap">
      <div class="section-head">
        <p class="kicker">Compared with a plan per person</p>
        <h2 id="compare-title">How the two add up</h2>
      </div>
      <div class="versus">
        <div class="card">
          <h3><Icon name="users" size={20} /> A subscription app</h3>
          <p>A free plan with limits, then a monthly or yearly plan per person for the full app. A household of four or a team of five pays four or five times, every month, for as long as they use it. Your lists live on the company's servers.</p>
        </div>
        <div class="card us">
          <h3><Icon name="server" size={20} /> OpenTodo</h3>
          <p>One server, whatever it costs you, for everyone on it, with every feature. The person who runs it spends a little time. If you ever stop, <a href="/docs/import-export/">everyone downloads their data as one file</a> and takes it elsewhere.</p>
        </div>
      </div>
      <p class="meta" style="margin-top: 1rem">The <a href="/vs/">comparison pages</a> spell out the cost difference against each app, with the date it was last checked.</p>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="money-title">
    <div class="wrap narrow">
      <h2 id="money-title">Where the money goes</h2>
      <p class="lede">Nowhere, by default. OpenTodo sells nothing, has no paid tier and takes no cut of your hosting. It is built in the open by <a href="/about/">one maintainer and contributors</a>; if it earns a place in your day, a <a href="https://github.com/pixari/opentodo">star on GitHub</a> or <a href="https://buymeacoffee.com/pixari">a coffee</a> is welcome, and never expected.</p>
    </div>
  </section>

  <EndCta title="Try it before you spend anything." lede="The demo runs in your browser with nothing to install. When you like it, put it on a server you already have." />
</Base>
