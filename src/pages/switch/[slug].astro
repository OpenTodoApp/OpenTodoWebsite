---
// One switch page per app (website-help-and-howtos D4), rendered by SwitchPage, which the German
// guides share (german-pages D4).
import { getCollection } from 'astro:content';
import SwitchPage from '../../components/pages/SwitchPage.astro';

export async function getStaticPaths() {
  return (await getCollection('switch', (e) => e.data.lang === 'en')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
---
<SwitchPage entry={Astro.props.entry} />
