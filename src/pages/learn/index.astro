---
// /learn (website-catalog D1): the overview of the guidance library on the Features template:
// each type's first entries with a link to the type's page, then the fixes for common problems.
import Catalog from '../../components/catalog/Catalog.astro';
import CatalogRows from '../../components/catalog/CatalogRows.astro';
import EndCta from '../../components/EndCta.astro';
import DiscordButton from '../../components/DiscordButton.astro';
import { SITE } from '../../lib/site';
import { LEARN_TYPES, learnEntries, type LearnEntry } from '../../lib/learn';
import { learnRail } from '../../lib/catalog';

const all = await learnEntries();
const SHOWN = 5;
const row = (e: LearnEntry) => ({ title: e.title, href: e.href, line: e.summary, meta: e.length });
const fixes = all.filter((e) => e.group === 'Fix it');
---
<Catalog title="Learn" heading="Learn" description="Setup guides, switch guides, methods, how-tos and templates for OpenTodo, searchable together with the features and the docs." rail={learnRail(all)}>
  {LEARN_TYPES.map((t) => {
    const items = all.filter((e) => e.type === t.key && e.group !== 'Fix it');
    return <CatalogRows id={t.key} title={t.title} icon={t.icon} total={all.filter((e) => e.type === t.key).length} more={`/learn/${t.key}/`} items={items.slice(0, SHOWN).map(row)} />;
  })}
  <section class="catalog-rows" id="fix" aria-labelledby="fix-title">
    <h2 id="fix-title" class="catalog-rows-title"><span>Something is wrong</span><span class="count">{fixes.length}</span></h2>
    <ul>
      {fixes.map((e) => <li><a href={e.href}>{e.title}</a><p>{e.summary}</p></li>)}
      <li><a href="/docs/troubleshooting/">Everything else, in the docs</a></li>
    </ul>
    <p class="meta catalog-help">Still stuck? <a href={SITE.discord}>Ask on Discord</a> or <a href={`${SITE.appRepo}/issues`}>open an issue</a>.</p>
    <div class="cta-row"><DiscordButton small /></div>
  </section>
  <EndCta slot="after" title="Put it into practice." />
</Catalog>
