---
// /learn/topic/<slug> (website-catalog D1): everything that carries the topic's tags, by type, and posts.
import Catalog from '../../../components/catalog/Catalog.astro';
import CatalogRows from '../../../components/catalog/CatalogRows.astro';
import EndCta from '../../../components/EndCta.astro';
import { LEARN_TYPES, inTopic, learnEntries, type LearnEntry } from '../../../lib/learn';
import { learnRail } from '../../../lib/catalog';
import { publishedPosts, CATEGORY_LABELS } from '../../../lib/blog';
import { TOPICS } from '../../../lib/topics.mjs';

export function getStaticPaths() {
  return TOPICS.map((t) => ({ params: { slug: t.slug }, props: { topic: t } }));
}
const { topic } = Astro.props as { topic: (typeof TOPICS)[number] };
const all = await learnEntries();
const entries = inTopic(all, topic.slug);
const has = (tags: string[] | undefined) => (tags ?? []).some((t) => topic.tags.includes(t));
const posts = (await publishedPosts()).filter((p) => has(p.data.tags) || (topic.slug === 'owning-your-data' && p.data.category === 'ownership')).slice(0, 3);
const row = (e: LearnEntry) => ({ title: e.title, href: e.href, line: e.summary, meta: e.length });
---
<Catalog title={`${topic.title} · Learn`} heading={topic.title} crumb={{ label: 'Learn', href: '/learn/' }} description={`${topic.lede} Guides, templates, how-tos and posts on ${topic.title.toLowerCase()}.`} rail={learnRail(all)}>
  {LEARN_TYPES.map((t) => ({ t, items: entries.filter((e) => e.type === t.key) })).filter((g) => g.items.length).map(({ t, items }) => (
    <CatalogRows id={t.key} title={t.title} icon={t.icon} items={items.map(row)} />
  ))}
  {posts.length > 0 && <CatalogRows id="posts" title="From the blog" icon="newspaper" items={posts.map((p) => ({ title: p.data.title, href: `/blog/${p.id}/`, line: p.data.summary, meta: CATEGORY_LABELS[p.data.category] }))} />}
  <EndCta slot="after" title="Put it into practice." />
</Catalog>
