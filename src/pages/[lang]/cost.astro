---
// /<lang>/cost (website-languages D3): the cost page in the other languages,
// with the footprint from the bundle manifest like the English page.
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import LangNote from '../../components/LangNote.astro';
import Close from '../../components/sections/Close.astro';
import Statement from '../../components/sections/Statement.astro';
import Split from '../../components/sections/Split.astro';
import Catalogue from '../../components/sections/Catalogue.astro';
import { OTHER_LANGS } from '../../i18n/index.mjs';
import { DICT, fill } from '../../i18n/dict.mjs';
import { manifest, versionTag } from '../../lib/bundle';
import { SITE } from '../../lib/site';

export function getStaticPaths() {
  return OTHER_LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as keyof typeof DICT;
const t = DICT[lang];
const k = t.cost;
const c = t.common;
const f = manifest.facts;
const vars = { licence: f.license ?? 'AGPL-3.0', version: versionTag, minimum: f.minimumServer ? `${f.minimumServer[0].toUpperCase()}${f.minimumServer.slice(1)}` : '', memory: String(f.idleMemoryMB ?? ''), demo: SITE.demo };
// Only the facts the pinned bundle carries are shown (nothing is invented); the
// footprint sentence needs both of its figures.
const facts = [
  f.imageMB ? { label: k.facts.image, value: `~ ${f.imageMB} MB` } : f.binaryMB && { label: k.facts.binary, value: `~ ${Math.round(f.binaryMB)} MB` },
  f.idleMemoryMB && { label: k.facts.memory, value: `~ ${f.idleMemoryMB} MB` },
  f.minimumServer && { label: k.facts.server, value: f.minimumServer },
].filter(Boolean) as { label: string; value: string }[];
const costFacts = [
  { label: k.facts.licence, value: vars.licence, href: '/about/#licence' },
  { label: k.facts.accounts, value: k.facts.accountsValue, href: '/docs/invite-people/' },
  { label: k.facts.pays, value: k.facts.paysValue, href: '#server-title' },
];
const footprint = f.minimumServer && f.idleMemoryMB ? fill(k.server.footprint, vars) : '';
const homeIcons = ['house', 'package', 'server'];
---
<Base title={k.title} description={k.description} lang={lang}>
  <Statement page id="cost" kicker={k.kicker} title={k.h1} lede={fill(k.lede, vars)}>
    <dl slot="fact" class="facts" aria-label={k.kicker}>
      {costFacts.map((x) => <div><dt>{x.label}</dt><dd><a href={x.href}>{x.value}</a></dd></div>)}
    </dl>
  </Statement>

  <LangNote lang={lang} />

  <Split id="software" alt title={k.software.h2}>
    <Fragment slot="lede">{k.software.lede} <a href="/docs/sharing/">Sharing</a></Fragment>
    <ul slot="media" class="checks">
      {k.software.checks.map((x) => <li><Icon name="check" size={18} /> {fill(x, vars)}</li>)}
      <li><Icon name="book-open" size={18} /> <a href="/about/#licence">{vars.licence}</a> · <a href="/docs/offline-and-sync/">Offline</a> · <a href="/docs/assistant/">AI</a></li>
    </ul>
  </Split>

  <Catalogue id="server" kicker={k.server.kicker} title={k.server.h2}>
    <Fragment slot="lede">{k.server.lede} {footprint && `${footprint} `}{k.server.homesIntro} <a href="/docs/self-hosting/docker/">Docker</a></Fragment>
    {k.server.homes.map((h, i) => (
      <article class="card">
        <span class="card-icon"><Icon name={homeIcons[i]} size={22} /></span>
        <h3>{h.title}</h3>
        <p>{h.text}</p>
      </article>
    ))}
    <Fragment slot="after">
      {facts.length > 0 && (
        <>
          <dl class="facts" aria-label={`OpenTodo ${versionTag}`} style="margin-bottom: 0.75rem">
            {facts.map((x) => <div><dt>{x.label}</dt><dd>{x.value}</dd></div>)}
          </dl>
          <p class="meta" style="margin-bottom: 1.5rem">{fill(k.facts.figures, vars)} <a href="/docs/self-hosting/docker/">{k.facts.guide}</a>.</p>
        </>
      )}
      <p><a class="link-arrow" href="/self-host/">{k.server.link} <Icon name="arrow-right" size={16} /></a></p>
    </Fragment>
  </Catalogue>

  <Split id="work" alt kicker={k.work.kicker} title={k.work.h2} lede={k.work.lede}>
    <dl slot="media" class="fine-list">
      {k.work.items.map((it, i) => <div><dt>{it.dt}</dt><dd>{it.dd} <a href={['/docs/self-hosting/coolify/', '/docs/self-hosting/docker/#updating', '/docs/backups/', '/docs/install-app/'][i]}>{c.docs}</a></dd></div>)}
    </dl>
  </Split>

  <Catalogue id="compare" kicker={k.compare.kicker} title={k.compare.h2} bare>
    <div class="versus">
      <div class="card"><h3><Icon name="users" size={20} /> {k.compare.them.h3}</h3><p>{k.compare.them.text}</p></div>
      <div class="card us"><h3><Icon name="server" size={20} /> {k.compare.us.h3}</h3><p>{k.compare.us.text} <a href="/docs/import-export/">Export</a></p></div>
    </div>
    <p slot="after" class="meta"><a href="/vs/">{k.compare.meta}</a></p>
  </Catalogue>

  <Statement id="money" alt title={k.money.h2}>
    <Fragment slot="lede">{k.money.lede} <a href={SITE.appRepo}>GitHub</a> · <a href="https://buymeacoffee.com/pixari">Buy me a coffee</a></Fragment>
  </Statement>

  <Close title={k.end.title} lede={k.end.lede}>
    <Fragment slot="actions">
      <a class="btn btn-primary" href={SITE.demo}>{c.tryDemo} <Icon name="arrow-right" size={18} /></a>
      <a class="btn btn-secondary" href="/self-host/"><Icon name="server" size={18} /> {c.selfHost}</a>
    </Fragment>
  </Close>
</Base>
