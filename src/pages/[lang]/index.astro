---
// The home page in the other languages (website-languages D3, website-home-languages D1): the
// same story as the English page from the same component, with this language's strings and
// the language note under the hero. Links without a translated target lead to English pages.
import Base from '../../layouts/Base.astro';
import HomeStory from '../../components/home/HomeStory.astro';
import { OTHER_LANGS } from '../../i18n/index.mjs';
import { DICT, fill } from '../../i18n/dict.mjs';
import { featureCount } from '../../lib/features';

export function getStaticPaths() {
  return OTHER_LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as keyof typeof DICT;
const h = DICT[lang].home;
---
<Base title={h.title} bareTitle description={fill(h.description, { count: featureCount() })} lang={lang}>
  <HomeStory lang={lang} s={h} />
</Base>
