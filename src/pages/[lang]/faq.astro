---
// /<lang>/faq (website-languages D3): the FAQ in the other languages, with the
// same FAQPage structured data as the English page.
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import JsonLd from '../../components/JsonLd.astro';
import LangNote from '../../components/LangNote.astro';
import { OTHER_LANGS } from '../../i18n/index.mjs';
import { DICT, fill } from '../../i18n/dict.mjs';
import { manifest, versionTag } from '../../lib/bundle';
import { SITE } from '../../lib/site';

export function getStaticPaths() {
  return OTHER_LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as keyof typeof DICT;
const t = DICT[lang];
const q = t.faq;
const c = t.common;
const vars = { licence: manifest.facts.license ?? 'AGPL-3.0', version: versionTag, demo: SITE.demo };
const items = q.items.map((it) => ({ q: it.q, a: fill(it.a, vars) }));
const plain = (html: string) => html.replace(/<[^>]+>/g, '').replace(/\s+·\s+/g, '. ').trim();
---
<Base title={q.title} description={q.description} lang={lang}>
  <JsonLd slot="head" data={{ '@type': 'FAQPage', inLanguage: lang, mainEntity: items.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: plain(f.a) } })) }} />
  <section class="page-head">
    <div class="wrap narrow">
      <p class="kicker">{q.kicker}</p>
      <h1>{q.h1}</h1>
      <p class="lede">{fill(q.lede, vars)}</p>
    </div>
  </section>

  <LangNote lang={lang} />

  <section class="section faq" style="padding-top: 0">
    <div class="wrap narrow">
      {items.map((f, i) => (
        <details open id={`q${i + 1}`}>
          <summary><h2>{f.q}</h2></summary>
          <p set:html={f.a} />
        </details>
      ))}
    </div>
  </section>

  <section class="end-cta" aria-labelledby="end-cta-title">
    <div class="wrap">
      <h2 id="end-cta-title">{q.end.title}</h2>
      <p class="lede">{q.end.lede} <a href="/docs/troubleshooting/">Troubleshooting</a> · <a href="/help/">Help</a></p>
      <div class="cta-row center">
        <a class="btn btn-primary" href={SITE.demo}>{c.tryDemo} <Icon name="arrow-right" size={18} /></a>
        <a class="btn btn-secondary" href="/self-host/"><Icon name="server" size={18} /> {c.selfHost}</a>
      </div>
    </div>
  </section>
</Base>
