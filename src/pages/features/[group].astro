---
// /features/<group> (website-catalog D1): every feature of one group, rendered by FeaturesGroup,
// which /de/features/<group>/ shares (german-pages D2).
import FeaturesGroup from '../../components/pages/FeaturesGroup.astro';
import { featureGroups } from '../../lib/features';

export function getStaticPaths() {
  return featureGroups().map((g) => ({ params: { group: g.key } }));
}
---
<FeaturesGroup group={Astro.params.group!} />
