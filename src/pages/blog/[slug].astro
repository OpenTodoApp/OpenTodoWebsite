---
// One post (website-blog design D3, D4; website-blog-series D2).
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EndCta from '../../components/EndCta.astro';
import Icon from '../../components/Icon.astro';
import CoverImage from '../../components/blog/CoverImage.astro';
import DevNotice from '../../components/blog/DevNotice.astro';
import PostRow from '../../components/blog/PostRow.astro';
import JsonLd from '../../components/JsonLd.astro';
import { SITE } from '../../lib/site';
import { changelogUrl } from '../../lib/changelog';
import { CATEGORY_LABELS, SERIES, authorOf, categoryUrl, formatDate, isoDate, publishedPosts, readingMinutes, relatedPosts, seriesNeighbours, seriesUrl, type Post } from '../../lib/blog';

export async function getStaticPaths() {
  const all = await publishedPosts();
  return all.map((post, i) => ({ params: { slug: post.id }, props: { post, newer: all[i - 1], older: all[i + 1], all } }));
}
const { post, newer, older, all } = Astro.props as { post: Post; newer?: Post; older?: Post; all: Post[] };
const d = post.data;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
const author = authorOf(post);
const related = relatedPosts(post, all);
// A part of a series links to its neighbouring parts instead of the neighbouring posts (website-blog-series D2).
const series = d.series ? SERIES[d.series] : undefined;
const parts = seriesNeighbours(post, all);
const inSeries = !!(parts.previous || parts.next);
const prevLink = inSeries ? parts.previous : older;
const nextLink = inSeries ? parts.next : newer;
const og = d.cover ? (await getImage({ src: d.cover, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src : undefined;
---
<Base title={d.title} description={d.summary} ogType="article" image={og} crumbs={[{ name: 'Blog', href: '/blog/' }, { name: CATEGORY_LABELS[d.category], href: categoryUrl(d.category) }, { name: d.title, href: `/blog/${post.id}/` }]}>
  <link slot="head" rel="alternate" type="application/rss+xml" title="OpenTodo blog" href="/blog/feed.xml" />
  <JsonLd slot="head" data={{ '@type': 'BlogPosting', headline: d.title, description: d.summary, datePublished: isoDate(d.publishedAt), ...(d.updatedAt && { dateModified: isoDate(d.updatedAt) }), inLanguage: 'en', author: { '@type': 'Person', name: author.name, url: author.url }, publisher: { '@type': 'Organization', name: 'OpenTodo', url: SITE.url }, mainEntityOfPage: `${SITE.url}/blog/${post.id}/`, ...(og && { image: new URL(og, SITE.url).href }), articleSection: CATEGORY_LABELS[d.category] }} />
  <article>
    <header class="post-head">
      <div class="wrap">
        <p class="post-byline">
          <a href={categoryUrl(d.category)}>{CATEGORY_LABELS[d.category]}</a>
          <time datetime={isoDate(d.publishedAt)}>{formatDate(d.publishedAt)}</time>
          {d.updatedAt && <span>Updated <time datetime={isoDate(d.updatedAt)}>{formatDate(d.updatedAt)}</time></span>}
          <span>{readingMinutes(post.body)} min read</span>
        </p>
        {series && d.series && <p class="post-series"><a href={seriesUrl(d.series)}>{series.title} · Part {d.part}</a></p>}
        <h1>{d.title}</h1>
        <p class="lede">{d.summary}</p>
      </div>
    </header>
    {d.cover && (
      <div class="post-hero">
        <CoverImage cover={d.cover} alt={d.coverAlt} category={d.category} sizes="(min-width: 800px) 720px, 100vw" eager />
      </div>
    )}
    <div class="post-body">
      <div class="wrap">
        {d.inDevelopment && <DevNotice publishedAt={d.publishedAt} shippedIn={d.shippedIn} />}
        {d.release && (
          <aside class="post-notice post-notice-shipped" aria-label="Release">
            <Icon name="package" size={20} />
            <p>Every change in {d.release} is in the <a href={changelogUrl(d.release)}>changelog</a>.</p>
          </aside>
        )}
        {toc.length >= 4 && (
          <nav class="post-toc" aria-labelledby="toc-title">
            <h2 id="toc-title">On this page</h2>
            <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </nav>
        )}
        <div class="post-prose prose"><Content /></div>
        <footer class="post-author">
          <strong>{author.name}</strong>
          <p>{author.bio} <a href={author.url}>More about {author.name.split(' ')[0]}</a></p>
        </footer>
        {(prevLink || nextLink) && (
          <nav class="post-nav" aria-label={inSeries ? `More of ${series?.title}` : 'More posts'}>
            {prevLink ? <a class="prev" href={`/blog/${prevLink.id}/`} rel="prev"><span>{inSeries ? `Part ${prevLink.data.part}` : 'Previous post'}</span><strong>{prevLink.data.title}</strong></a> : <span />}
            {nextLink ? <a class="next" href={`/blog/${nextLink.id}/`} rel="next"><span>{inSeries ? `Part ${nextLink.data.part}` : 'Next post'}</span><strong>{nextLink.data.title}</strong></a> : <span />}
          </nav>
        )}
      </div>
    </div>
  </article>
  {related.length > 0 && (
    <section class="post-related" aria-labelledby="related-title">
      <div class="wrap">
        <h2 id="related-title">More in {CATEGORY_LABELS[d.category]}</h2>
        <ol class="post-rows">{related.map((p) => <PostRow post={p} headingLevel={3} />)}</ol>
      </div>
    </section>
  )}
  <EndCta kind="follow" />
</Base>
