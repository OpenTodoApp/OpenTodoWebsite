---
// One install page per platform (website-help-and-howtos D3), rendered by InstallPlatform, which
// /de/install/<platform>/ shares (german-pages D2).
import InstallPlatform from '../../components/pages/InstallPlatform.astro';
import { PLATFORMS } from '../../lib/install';

export function getStaticPaths() {
  return PLATFORMS.map((p) => ({ params: { platform: p.slug } }));
}
---
<InstallPlatform slug={Astro.params.platform!} />
