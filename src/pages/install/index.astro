---
// /install (website-help-and-howtos D3): one card per platform.
import Base from '../../layouts/Base.astro';
import Close from '../../components/sections/Close.astro';
import Icon from '../../components/Icon.astro';
import { INSTALL_DOC, PLATFORMS } from '../../lib/install';
---
<Base title="Install the app" description="Install OpenTodo on iPhone, iPad, Android, Windows, Mac, Linux and ChromeOS straight from the browser. No app store, works offline, reminders included.">
  <section class="page-head">
    <div class="wrap">
      <p class="kicker">Install the app</p>
      <h1>On your phone and your computer, from the browser.</h1>
      <p class="lede">OpenTodo is not in the app stores, and does not need to be. Open your server's address, choose install, and it gets its own icon, its own window, works without a connection and shows reminders while it is closed. Pick your device. <a href={INSTALL_DOC}>How installing works</a></p>
    </div>
  </section>
  <section class="section" style="padding-top: 1rem">
    <div class="wrap">
      <ul class="grid grid-3 plain">
        {PLATFORMS.map((p) => (
          <li><a class="card" href={`/install/${p.slug}/`}><span class="card-icon"><Icon name={p.icon} size={22} /></span><h2 style="font-size: 1.2rem">{p.name}</h2><p>{p.short}</p></a></li>
        ))}
      </ul>
      <p class="meta" style="margin-top: 1.5rem">Firefox on a computer does not install web apps; OpenTodo still works fully in a Firefox tab, offline included. <a href="/docs/install-app/#windows-macos-linux-and-chromeos">Details</a></p>
    </div>
  </section>
  <Close title="No server to sign in to yet?" lede="Try the demo in your browser first, or see how to get OpenTodo." />
</Base>
