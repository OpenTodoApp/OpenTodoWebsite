---
// /hosting (hosting-choice-page): where to run OpenTodo. Which option suits whom, then every
// listed host and your own server side by side, in the order of how much you look after yourself,
// least first, each with the same facts in the same order, one button and its setup steps. The
// hosts' facts are their own, with the day they were checked (MANAGED_HOSTS). One disclosure.
// English only, like every page but the home page (website-languages). Plain HTML, so it reads
// without JavaScript.
import Base from '../layouts/Base.astro';
import { docExists } from '../lib/bundle';
import { FACTS, MANAGED_HOSTS, MANAGED_HOSTS_NOTE, OWN_SERVER, type Facts } from '../lib/hosting';

const slug = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const owns = (name: string) => (name.endsWith('s') ? `${name}’` : `${name}’s`);
const day = (iso: string) => new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

interface Option { id: string; name: string; facts: Facts; steps: string[]; button: { label: string; href: string }; checked?: string; guide?: string; extra?: string }
const options: Option[] = [
  ...MANAGED_HOSTS.map((h) => ({
    id: slug(h.name), name: h.name, facts: h.facts, steps: h.steps, button: { label: h.button, href: h.url },
    checked: h.checkedOn, guide: docExists(h.guide) ? h.guide : undefined,
  })),
  {
    id: 'own', name: 'Your own server', facts: OWN_SERVER, button: { label: 'Self-host', href: '/self-host/' },
    steps: [
      'Pick your hardware on <a href="/self-host/">Self-host</a> and follow its guide.',
      'Open the address and create the owner account.',
      'Put the app on your phone and computer: <a href="/install/">Install the app</a>.',
    ],
  },
];
const which = [
  ...MANAGED_HOSTS.map((h) => ({ text: h.who, name: h.name, id: slug(h.name) })),
  { text: 'Free, on hardware you own', name: 'Your own server', id: 'own' },
];
const description = `${[...MANAGED_HOSTS.map((h) => h.name), 'your own server'].join(', ').replace(/, ([^,]*)$/, ' or $1')}: what each costs, how setup, updates, backups and your own domain work, and how to leave with your data.`;
---
<Base title="Where to run OpenTodo" description={description}>
  <section class="page-head" aria-labelledby="hosting-title">
    <div class="wrap">
      <h1 id="hosting-title">Where to run OpenTodo</h1>
      <ul class="hosting-which">
        {which.map((w) => <li>{w.text}: <a href={`#${w.id}`}>{w.name}</a></li>)}
      </ul>
    </div>
  </section>

  <section class="section start-block hosting-options-block" aria-label="The options">
    <div class="wrap">
      <p class="hosting-order">In order of how much you look after yourself, least first.</p>
      <div class="hosting-options">
        {options.map((o) => (
          <section class="hosting-option" id={o.id} aria-labelledby={`${o.id}-title`}>
            <h2 id={`${o.id}-title`}>{o.name}</h2>
            <dl class="hosting-facts">
              {FACTS.map((f) => (<><dt>{f}</dt><dd set:html={o.facts[f]} /></>))}
            </dl>
            <a class="btn btn-primary" href={o.button.href}>{o.button.label}</a>
            <h3>Set it up</h3>
            <ol class="steps">{o.steps.map((s) => <li set:html={s} />)}</ol>
            {o.guide && <p class="hosting-meta"><a href={o.guide}>{o.name} guide</a></p>}
            {o.checked && <p class="hosting-meta">From {owns(o.name)} own pages, checked <time datetime={o.checked}>{day(o.checked)}</time>.</p>}
          </section>
        ))}
      </div>
      {MANAGED_HOSTS.length > 0 && <p class="hosting-note" id="disclosure">{MANAGED_HOSTS_NOTE}</p>}
    </div>
  </section>
</Base>
