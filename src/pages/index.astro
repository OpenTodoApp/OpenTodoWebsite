---
// Home page (website-navigation-and-home D4): seven sections built from the section
// types. The hero with one button; the three ways to get OpenTodo; the product;
// why running it yourself pays off; one grid of everyday features and what sets
// OpenTodo apart; working offline; the latest post and the close. No architecture
// terms above the fold.
import Base from '../layouts/Base.astro';
import Close from '../components/sections/Close.astro';
import Split from '../components/sections/Split.astro';
import Showcase from '../components/sections/Showcase.astro';
import Catalogue from '../components/sections/Catalogue.astro';
import FeatureTour from '../components/FeatureTour.astro';
import HeroDemo from '../components/HeroDemo.astro';
import Icon from '../components/Icon.astro';
import ImportStrip from '../components/ImportStrip.astro';
import ScreenshotFrame from '../components/ScreenshotFrame.astro';
import SyncIllustration from '../components/SyncIllustration.astro';
import ProofStrip from '../components/ProofStrip.astro';
import { SITE } from '../lib/site';
import { CATEGORY_LABELS, formatDate, isoDate, publishedPosts } from '../lib/blog';
import JsonLd from '../components/JsonLd.astro';
import { manifest, versionTag } from '../lib/bundle';

// The latest post, as one line above the close (website-blog "Blog in navigation and on the home page").
const latest = (await publishedPosts())[0];

// Everyday features and what sets OpenTodo apart, in one grid of nine (D4).
const features = [
  { icon: 'calendar-check', title: 'Today and Upcoming', text: 'See what is due today, what is overdue, and what the rest of the week looks like.', doc: '/docs/views/' },
  { icon: 'folder', title: 'Projects, sections and boards', text: 'Group tasks into projects, split them into sections, and switch to a board when you want columns.', doc: '/docs/sections-and-boards/' },
  { icon: 'alarm-clock', title: 'Reminders and repeating tasks', text: 'Get a notification before something is due. "Every Monday" or "every 2 weeks" just works.', doc: '/docs/recurring-and-reminders/' },
  { icon: 'tag', title: 'Labels and filters', text: 'Tag tasks with @errand or @call, then save a filter like "due this week and not done" to the sidebar.', doc: '/docs/labels-and-filters/' },
  { icon: 'users', title: 'Shared lists', text: 'Share a project with your partner or your team, assign tasks, and leave comments on them.', doc: '/docs/sharing/' },
  { icon: 'wifi-off', title: 'Works without a connection', text: 'Install it from the browser on any phone or computer. It keeps a full copy of your tasks, so the train and the plane are fine.', doc: '/docs/offline-and-sync/' },
  { icon: 'lock', title: 'Encrypted, if you want', text: 'Turn it on and your task titles and notes are encrypted on your devices before they reach the server.', doc: '/docs/e2ee/' },
  { icon: 'keyboard', title: 'Fast from the keyboard', text: 'Type "call the dentist tomorrow 9am #Home" and it becomes a task with a date, a time and a project.', doc: '/docs/keyboard/' },
  { icon: 'sparkles', title: 'An assistant, with your own key', text: 'Off until you turn it on. Pick the model and the provider; you see every change before it happens.', doc: '/docs/ai-and-agents/' },
];
// The three real ways to get OpenTodo (website-first-visit D1). The demo
// sandbox lifetime is as /docs/self-hosting/demo/ states it for the pinned release.
// The hero promise, at most 25 words (the content check enforces it).
const HERO_PROMISE = 'Plan your day, share lists with your household or team, and keep every task on a server you own. No monthly plan per person.';
const paths = [
  { icon: 'sparkles', when: 'I want to see it first', title: 'Try the demo', text: 'Opens in your browser with nothing to install. You get a private sandbox with sample projects that nobody else can see; it is deleted after two hours without activity.', effort: 'Two minutes. Nothing to install.', href: SITE.demo, cta: 'Open the demo', more: { href: '/docs/self-hosting/demo/', label: 'What the demo keeps and for how long' } },
  { icon: 'users-round', when: 'Someone I know runs a server', title: 'Join with the link you were sent', text: 'Open the invitation link, choose a name and password, and you are in. Then install the app on your phone and laptop straight from the browser, no app store involved.', effort: 'Five minutes. No setup on your side.', href: '/docs/getting-started/', cta: 'How to join', more: { href: '/docs/install-app/', label: 'Install it on your phone and computer' } },
  { icon: 'server', when: 'I will run it myself', title: 'Run it on your own server', text: 'One container, one folder of data, no database server to set up. A small VPS, a Raspberry Pi or a machine already at home is enough, and the only cost is that server.', effort: 'About twenty minutes the first time.', href: '/self-host/', cta: 'Install it', more: { href: '/cost/', label: 'What it costs, in words' } },
];
---
<Base title="OpenTodo · A to-do app that runs on your own server" bareTitle description="OpenTodo is a free, open-source to-do app you run on your own server. Plan your day, set reminders, share lists with your family or team, work offline on every device, and add an AI assistant with the model and key you choose. No subscription.">
  <JsonLd slot="head" data={[
    { '@type': 'WebSite', name: 'OpenTodo', url: SITE.url, inLanguage: 'en' },
    { '@type': 'SoftwareApplication', name: 'OpenTodo', url: SITE.url, applicationCategory: 'ProductivityApplication', operatingSystem: 'Web, iOS, Android, Windows, macOS, Linux (self-hosted server: Docker on linux/amd64 and linux/arm64)', softwareVersion: manifest.version, license: `${SITE.appRepo}/blob/main/LICENSE`, isAccessibleForFree: true, downloadUrl: SITE.appRepo, installUrl: `${SITE.url}/self-host/`, softwareHelp: `${SITE.url}/help/`, releaseNotes: `${SITE.url}/whats-new/${manifest.version}/`, description: `Free, open-source, self-hosted task manager ${versionTag}: tasks, projects, reminders, sharing, offline on every device.` },
  ]} />
  <section data-section-type="split" class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow"><Icon name="heart" size={16} /> Free and open source</p>
        <h1 id="hero-title">A to-do app that runs on <span class="accent">your own server.</span></h1>
        <p class="lede" data-hero-promise>{HERO_PROMISE}</p>
        <div class="cta-row">
          <a class="btn btn-primary" href={SITE.demo}>Try the demo <Icon name="arrow-right" size={18} /></a>
        </div>
        <p class="hero-links"><a class="link-arrow" href="/self-host/">Install it on your server <Icon name="arrow-right" size={16} /></a> <a class="link-arrow" href="#switch">Bring your tasks over <Icon name="arrow-right" size={16} /></a></p>
        <p class="hero-note">Works on your phone and your computer, with or without a connection.</p>
      </div>
      <div>
        <HeroDemo />
      </div>
    </div>
  </section>

  <Catalogue id="get-it" kicker="How do I get it?" title="Three ways in. Pick the one that fits you." lede="OpenTodo is not offered as a hosted service, so there is no account to sign up for here. You try it in the demo, you join a server someone you know runs, or you run one yourself." bare>
    <ol class="grid grid-3 paths">
      {paths.map((p) => (
        <li class="card">
          <span class="card-icon"><Icon name={p.icon} size={22} /></span>
          <p class="path-when">{p.when}</p>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
          <p class="meta">{p.effort}</p>
          <a class="card-link" href={p.href}>{p.cta} <Icon name="arrow-right" size={16} /></a>
          {p.more && <p class="meta" style="margin-top: 0.5rem"><a href={p.more.href}>{p.more.label}</a></p>}
        </li>
      ))}
    </ol>
    <ImportStrip inline slot="after" />
  </Catalogue>

  <Showcase id="tour" alt kicker="The app" title="See what it looks like." lede="These are screenshots of the real app, taken from the current release with example data. Pick a topic, then a feature.">
    <FeatureTour />
  </Showcase>

  <Split id="household" kicker="For families and small teams" title="One server for everyone at home. Nobody pays per person." lede="Whoever does not mind a bit of setup installs OpenTodo on a small server, a cheap VPS or a Raspberry Pi. Everyone else opens the app on their phone or laptop and uses it like any other to-do app.">
    <ul class="checks">
      <li><Icon name="check" size={18} /> Each person gets their own account and their own lists; <a href="/docs/sharing/">share the shopping list, the move or the holiday</a> with whoever needs it</li>
      <li><Icon name="check" size={18} /> Invite people with a link; they <a href="/docs/install-app/">install the app from the browser</a>, no app store involved</li>
      <li><Icon name="check" size={18} /> The only cost is the server, <a href="/cost/">described in words</a></li>
    </ul>
    <p>And if you ever leave, <a href="/docs/import-export/">everyone downloads their data as one file</a>. Nothing keeps you here except that it works.</p>
    <div slot="media" class="phones">
      <ScreenshotFrame shot="mobile-dark" frame="phone" alt="Today view on a phone in dark mode" />
      <ScreenshotFrame shot="mobile-detail" frame="phone" alt="Task detail panel on a phone" />
    </div>
  </Split>

  <Catalogue id="features" alt kicker="What you get" title="Everything you use a to-do app for, and a few things others do not do." lede="If you are coming from Todoist, Things or TickTick, the things you rely on every day are here.">
    {features.map((b) => (
      <article class="card">
        <span class="card-icon"><Icon name={b.icon} size={22} /></span>
        <h3>{b.title}</h3>
        <p>{b.text}</p>
        <a class="card-link" href={b.doc}>How it works <Icon name="arrow-right" size={16} /></a>
      </article>
    ))}
    <p slot="after"><a class="link-arrow" href="/playground/">Try quick add and filters in your browser <Icon name="arrow-right" size={16} /></a></p>
  </Catalogue>

  <Split id="self-host" kicker="Offline, on every device" title="Edit the same task on your phone and your laptop, and both changes stick." lede='Each of your devices keeps a copy of your tasks and swaps its changes with the others through your server. There is no "which version do you want to keep?" dialog.'>
    <div class="cta-row">
      <a class="btn btn-secondary" href="/self-host/#sync">See sync in action <Icon name="arrow-right" size={18} /></a>
      <a class="btn btn-secondary" href="/developers/"><Icon name="braces" size={18} /> For developers</a>
    </div>
    <SyncIllustration slot="media" />
  </Split>

  {latest && (
    <div class="wrap latest-post">
      <p><span class="post-cat">{CATEGORY_LABELS[latest.data.category]}</span> <a href={`/blog/${latest.id}/`}>{latest.data.title}</a> <time class="meta" datetime={isoDate(latest.data.publishedAt)}>{formatDate(latest.data.publishedAt)}</time> <a class="link-arrow" href="/blog/">All posts <Icon name="arrow-right" size={16} /></a></p>
    </div>
  )}

  <Close title="Try it first, then make it yours." lede="Start with the demo. When you like it, put it on your own server and bring your tasks over.">
    <ProofStrip slot="before" />
  </Close>
</Base>
