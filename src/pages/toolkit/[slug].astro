---
import { getCollection } from 'astro:content';
import ArticlePage from '../../components/ArticlePage.astro';
export async function getStaticPaths() {
  return (await getCollection('toolkit', (e) => !e.data.draft)).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
---
<ArticlePage entry={entry} section={{ href: '/learn/setup/', label: 'Start here' }} />
