---
import Base from '../../layouts/Base.astro';
import EndCta from '../../components/EndCta.astro';
import Icon from '../../components/Icon.astro';
import { releases } from '../../lib/bundle';
import { inline } from '../../lib/changelog';
const day = (s: string) => new Date(`${s}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Base title="What's new" description="Every OpenTodo release, what it added and what changed.">
  <section class="page-head">
    <div class="wrap">
      <p class="kicker">What's new</p>
      <h1>Releases</h1>
      <p class="lede">Every released version of OpenTodo, newest first. Subscribe with the <a href="/feed.xml">RSS feed</a>.</p>
    </div>
  </section>
  <section class="section" style="padding-top: 1rem">
    <div class="wrap grid">
      {releases.map((r) => (
        <a class="card" href={`/whats-new/${r.version}/`}>
          <h2 style="font-size: 1.35rem">OpenTodo {r.version}</h2>
          <p class="meta"><time datetime={r.date}>{day(r.date)}</time></p>
          {r.summary && <p set:html={inline(r.summary.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1'))} />}
          <span class="card-link">Read the release notes <Icon name="arrow-right" size={16} /></span>
        </a>
      ))}
    </div>
  </section>
  <EndCta />
</Base>
