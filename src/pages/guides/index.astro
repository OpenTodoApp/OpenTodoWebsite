---
// /guides (website-templates-and-methods D3): the methods catalogue, with tags
// (static filter pages) and the quiz.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EndCta from '../../components/EndCta.astro';
import Icon from '../../components/Icon.astro';
import { CONTENT_TAGS, TAG_LABELS } from '../../content/schemas.mjs';

const entries = (await getCollection('guides', (e) => !e.data.draft)).sort((a, b) => a.data.order - b.data.order);
const used = CONTENT_TAGS.filter((t) => entries.some((e) => e.data.tags.includes(t)));
const templates = await getCollection('templates');
const templateOf = (id: string) => templates.find((t) => t.id === id);
---
<Base title="Guides" description="Short, practical guides to well-known ways of working, GTD, the weekly review, time blocking, Pomodoro, Kanban, PARA and more, each set up in OpenTodo with a template you can import.">
  <section class="page-head">
    <div class="wrap">
      <p class="kicker">Guides</p>
      <h1>Well-known ways of working, set up in OpenTodo.</h1>
      <p class="lede">Each guide explains a method in a few minutes, then shows how to run it with projects, labels, saved views and the calendar, with a template you can import. Pick by what you struggle with, or <a href="/guides/quiz/">answer two questions</a>.</p>
      <ul class="jump" aria-label="Filter by tag">
        <li><a href="/guides/" aria-current="page">All</a></li>
        {used.map((t) => <li><a href={`/guides/tag/${t}/`}>{TAG_LABELS[t as keyof typeof TAG_LABELS]}</a></li>)}
      </ul>
    </div>
  </section>
  <section class="section" style="padding-top: 1rem">
    <div class="wrap">
      <ul class="grid grid-3 plain">
        {entries.map((e) => (
          <li><a class="card" href={`/guides/${e.id}/`}>
            <span class="card-icon"><Icon name="compass" size={22} /></span>
            <h2 style="font-size: 1.2rem">{e.data.title}</h2>
            <p>{e.data.summary}</p>
            <ul class="tag-row" aria-label="Tags">{e.data.tags.map((t) => <li class="tag">{TAG_LABELS[t as keyof typeof TAG_LABELS]}</li>)}</ul>
            {e.data.templates.length > 0 && <p class="meta">Template: {e.data.templates.map((t) => templateOf(t)?.data.title ?? t).join(', ')}</p>}
          </a></li>
        ))}
      </ul>
    </div>
  </section>
  <section class="section section-alt" aria-labelledby="quiz-title">
    <div class="wrap split">
      <div>
        <p class="kicker">Not sure where to start?</p>
        <h2 id="quiz-title">Two questions, one method to try this week.</h2>
        <p class="lede">What gets in the way most, and what kind of habit sounds doable. The answer is a guide and a template, not a sign-up form.</p>
        <a class="btn btn-primary" href="/guides/quiz/">Take the quiz <Icon name="arrow-right" size={18} /></a>
      </div>
      <div class="card">
        <h3>More to read</h3>
        <ul class="checks" style="margin: 0">
          <li><Icon name="life-buoy" size={16} /><a href="/toolkit/">Toolkit: set it up for your household or team</a></li>
          <li><Icon name="list-checks" size={16} /><a href="/how-to/">How-tos, one task each</a></li>
          <li><Icon name="newspaper" size={16} /><a href="/blog/category/ownership/">Essays on owning your tasks</a></li>
          <li><Icon name="map" size={16} /><a href="/topics/">Everything by topic</a></li>
        </ul>
      </div>
    </div>
  </section>
  <EndCta />
</Base>
