---
// /guides/quiz (website-templates-and-methods D4): the first question. Every
// answer is a link to a static page, so the quiz needs no script.
import Base from '../../../layouts/Base.astro';
import Trail from '../../../components/Trail.astro';
import Icon from '../../../components/Icon.astro';
import { QUIZ } from '../../../lib/quiz';
---
<Base title="Which method fits you?" description="Two questions, one way of working to try this week, with the guide and the template that set it up in OpenTodo. No sign-up, no script.">
  <section class="page-head">
    <div class="wrap narrow">
      <Trail steps={[{ href: '/guides/', label: 'Guides' }]} />
      <p class="kicker">Which method fits you?</p>
      <h1>{QUIZ.question}</h1>
      <p class="lede">Question 1 of 2. Pick the one that sounds most like your week; there is no wrong answer, and you can come back and try another.</p>
      <ul class="quiz-options">
        {QUIZ.options.map((o) => <li><a class="card" href={`/guides/quiz/${o.slug}/`}>{o.label} <Icon name="arrow-right" size={18} /></a></li>)}
      </ul>
    </div>
  </section>
</Base>
