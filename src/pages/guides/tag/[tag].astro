---
// /guides/tag/<tag> (website-templates-and-methods D3): the catalogue for one tag.
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import EndCta from '../../../components/EndCta.astro';
import Icon from '../../../components/Icon.astro';
import { CONTENT_TAGS, TAG_LABELS } from '../../../content/schemas.mjs';

export function getStaticPaths() {
  return CONTENT_TAGS.map((t) => ({ params: { tag: t } }));
}
const tag = Astro.params.tag as keyof typeof TAG_LABELS;
const label = TAG_LABELS[tag];
const all = (await getCollection('guides', (e) => !e.data.draft)).sort((a, b) => a.data.order - b.data.order);
const entries = all.filter((e) => e.data.tags.includes(tag));
const used = CONTENT_TAGS.filter((t) => all.some((e) => e.data.tags.includes(t)));
const templates = (await getCollection('templates')).filter((t) => t.data.tags.includes(tag));
---
<Base title={`Guides: ${label.toLowerCase()}`} description={`Ways of working for ${label.toLowerCase()}, each set up in OpenTodo with a template.`}>
  <section class="page-head">
    <div class="wrap">
      <p class="breadcrumb"><a href="/guides/">Guides</a></p>
      <h1>Guides for {label.toLowerCase()}.</h1>
      <p class="lede">{entries.length === 0 ? 'No guide carries this tag yet; the templates below do.' : `${entries.length === 1 ? 'One method' : `${entries.length} methods`} that help with ${label.toLowerCase()}, each with the OpenTodo setup and a template.`}</p>
      <ul class="jump" aria-label="Filter by tag">
        <li><a href="/guides/">All</a></li>
        {used.map((t) => <li><a href={`/guides/tag/${t}/`} aria-current={t === tag ? 'page' : undefined}>{TAG_LABELS[t as keyof typeof TAG_LABELS]}</a></li>)}
      </ul>
    </div>
  </section>
  <section class="section" style="padding-top: 1rem">
    <div class="wrap">
      {entries.length > 0 && (
        <ul class="grid grid-3 plain">
          {entries.map((e) => (
            <li><a class="card" href={`/guides/${e.id}/`}><span class="card-icon"><Icon name="compass" size={22} /></span><h2 style="font-size: 1.2rem">{e.data.title}</h2><p>{e.data.summary}</p></a></li>
          ))}
        </ul>
      )}
      {templates.length > 0 && (
        <>
          <h2 style="font-size: 1.4rem; margin-top: 2.5rem">Templates for {label.toLowerCase()}</h2>
          <ul class="grid grid-3 plain">
            {templates.map((t) => <li><a class="card" href={`/templates/${t.id}/`}><span class="card-icon"><Icon name="layout-template" size={22} /></span><h3>{t.data.title}</h3><p>{t.data.summary}</p></a></li>)}
          </ul>
        </>
      )}
      {entries.length === 0 && templates.length === 0 && <p class="lede">Nothing carries this tag yet. <a href="/guides/">All guides</a></p>}
    </div>
  </section>
  <EndCta />
</Base>
