---
// The layout every page shares (website-platform design D3): header and main
// navigation, footer, skip link, light and dark from the bundle's tokens, the
// preview marker and the self-hosted analytics.
import '@bundle/tokens/tokens.css';
import '../styles/site.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { bundle } from '../lib/bundle';
import { SITE } from '../lib/site';
import { ogPathFor } from '../../scripts/lib/og.mjs';

interface Props {
  title: string;
  description: string;
  /** Omit the " · OpenTodo" suffix (the home page). */
  bareTitle?: boolean;
  ogType?: 'website' | 'article';
  /** Social preview image (a site path or URL, 1200x630); defaults to the site image. */
  image?: string;
}
const { title, description, bareTitle = false, ogType = 'website', image } = Astro.props;
// Every page gets its own social card (website-seo D2), drawn after the build from this
// page's title and description; a page may pass its own image (a post's cover) instead.
const ogImage = image ? new URL(image, SITE.url).href : `${SITE.url}${ogPathFor(Astro.url.pathname)}`;
const fullTitle = bareTitle ? title : `${title} · OpenTodo`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f8fafc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#020617" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="OpenTodo" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={image ? description : `${fullTitle}: ${description}`} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/InterVariable-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="alternate" type="application/rss+xml" title="OpenTodo" href="/feed.xml" />
    {bundle.preview && <meta name="robots" content="noindex" />}
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
    <!-- Analytics (Umami, self-hosted, no cookies): this website only; the app never loads analytics. -->
    <script is:inline defer data-cfasync="false" src={SITE.analytics.src} data-website-id={SITE.analytics.websiteId}></script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {bundle.preview && (
      <div class="preview-banner" role="note">
        <div class="wrap"><strong>Preview</strong>: built from {bundle.label}, not from a release. Not for production.</div>
      </div>
    )}
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <!-- Custom events on top of Umami's page views. Served at /analytics.js because the bundle's docs load it from there too. -->
    <script is:inline src="/analytics.js" defer data-cfasync="false"></script>
  </body>
</html>
