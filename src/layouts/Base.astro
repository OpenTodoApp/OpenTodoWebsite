---
// The layout every page shares (website-platform design D3): header and main
// navigation, footer, skip link, light and dark from the bundle's tokens, the
// preview marker and the self-hosted analytics.
import { BRAND } from '../lib/brand';
import '@bundle/tokens/tokens.css';
import '../styles/site.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SurveyStrip from '../components/SurveyStrip.astro';
import { SURVEY, surveyActive } from '../lib/survey.mjs';
import { bundle } from '../lib/bundle';
import { SITE } from '../lib/site';
import { ogPathFor } from '../../scripts/lib/og.mjs';
import { DEFAULT_LANG, LANGS, alternatesFor } from '../i18n/index.mjs';

interface Props {
  title: string;
  description: string;
  /** Omit the " · OpenTodo" suffix (the home page). */
  bareTitle?: boolean;
  ogType?: 'website' | 'article';
  /** Social preview image (a site path or URL, 1200x630); defaults to the site image. */
  image?: string;
  /** The page's language (website-languages); English unless a translated page says otherwise. */
  lang?: keyof typeof LANGS;
  /** The page's place in the site, home excluded, for the BreadcrumbList (website-seo-depth D2). */
  crumbs?: { name: string; href: string }[];
  /** The page's schema.org type (site-polish D2): a list of pieces is a CollectionPage. */
  schemaType?: 'WebPage' | 'CollectionPage' | 'AboutPage';
}
const { title, bareTitle = false, ogType = 'website', image, lang = DEFAULT_LANG, crumbs, schemaType = 'WebPage' } = Astro.props;
// Search results show about 160 characters (website-seo-depth D1): a longer description is cut at
// the last sentence, or the last word, that fits.
const clamp = (s: string, max = 160) => {
  if (s.length <= max) return s;
  const cut = s.slice(0, max - 1);
  const sentence = cut.lastIndexOf('. ');
  return sentence > 80 ? cut.slice(0, sentence + 1) : `${cut.slice(0, cut.lastIndexOf(' '))}…`;
};
const description = clamp(Astro.props.description);
// Pages that exist in every language point at each other (hreflang), English being the default.
const alternates = alternatesFor(Astro.url.pathname);
// Every page gets its own social card (website-seo D2), drawn after the build from this
// page's title and description; a page may pass its own image (a post's cover) instead.
const ogImage = image ? new URL(image, SITE.url).href : `${SITE.url}${ogPathFor(Astro.url.pathname)}`;
// A title that already names OpenTodo (a release post, "About OpenTodo") needs no suffix (site-polish D1).
const fullTitle = bareTitle || title.includes('OpenTodo') ? title : `${title} · OpenTodo`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogAlt = image ? description : `${fullTitle}: ${description}`;
// Every page says what it is and which site it belongs to (site-polish D2): one JSON-LD graph,
// a WebPage tied to the WebSite and the Organization the home page describes, and the page's
// BreadcrumbList when it has a place in the site (website-seo-depth D2).
const breadcrumb = crumbs && crumbs.length > 0 ? {
  '@type': 'BreadcrumbList', '@id': `${canonical}#breadcrumb`,
  itemListElement: [{ name: 'OpenTodo', href: '/' }, ...crumbs].map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.href, SITE.url).href })),
} : undefined;
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': schemaType, '@id': `${canonical}#webpage`, url: canonical, name: fullTitle, description, inLanguage: LANGS[lang].hreflang,
      isPartOf: { '@type': 'WebSite', '@id': `${SITE.url}/#website`, name: SITE.name, url: SITE.url },
      publisher: { '@type': 'Organization', '@id': `${SITE.url}/#organization`, name: SITE.name, url: SITE.url },
      primaryImageOfPage: ogImage,
      ...(breadcrumb && { breadcrumb: { '@id': breadcrumb['@id'] } }),
    },
    ...(breadcrumb ? [breadcrumb] : []),
  ],
};
// The survey strip is built until its end date (survey-strip), then leaves on its own.
const survey = surveyActive();
---
<!doctype html>
<html lang={LANGS[lang].hreflang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f8fafc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#020617" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="OpenTodo" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:locale" content={LANGS[lang].og} />
    {alternates && alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={new URL(a.href, SITE.url).href} />)}
    {alternates && <link rel="alternate" hreflang="x-default" href={new URL(alternates[0].href, SITE.url).href} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={`@${new URL(SITE.x).pathname.slice(1)}`} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <link rel="icon" href={BRAND.favicon} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={BRAND.touchIcon} />
    <link rel="preload" href="/fonts/InterVariable-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="alternate" type="application/rss+xml" title="OpenTodo" href="/feed.xml" />
    <meta name="robots" content={bundle.preview ? 'noindex' : 'max-image-preview:large'} />
    {SITE.verification.google && <meta name="google-site-verification" content={SITE.verification.google} />}
    {SITE.verification.bing && <meta name="msvalidate.01" content={SITE.verification.bing} />}
    <script type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, '\\u003c')} />
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
    {survey && <script is:inline define:vars={{ key: SURVEY.key }}>try { if (localStorage.getItem(key)) document.documentElement.classList.add('survey-closed'); } catch {}</script>}
    <!-- Analytics (Umami, self-hosted, no cookies): this website only; the app never loads analytics. -->
    <script is:inline defer data-cfasync="false" src={SITE.analytics.src} data-website-id={SITE.analytics.websiteId}></script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {bundle.preview && (
      <div class="preview-banner" role="note">
        <div class="wrap"><strong>Preview</strong>: built from {bundle.label}, not from a release. Not for production.</div>
      </div>
    )}
    {survey && <SurveyStrip lang={lang} />}
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter lang={lang} />
    <!-- Custom events on top of Umami's page views. Served at /analytics.js because the bundle's docs load it from there too. -->
    <script is:inline src="/analytics.js" defer data-cfasync="false"></script>
    <!-- The header menu and the language switch are <details>: they work without JavaScript; this only closes them on Escape or a click elsewhere. -->
    <script is:inline>
      (() => {
        const open = () => document.querySelectorAll('details.nav-menu[open], details.lang-switch[open]');
        document.addEventListener('click', (e) => open().forEach((d) => { if (!d.contains(e.target)) d.open = false; }));
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') open().forEach((d) => { d.open = false; d.querySelector('summary').focus(); }); });
      })();
    </script>
  </body>
</html>
